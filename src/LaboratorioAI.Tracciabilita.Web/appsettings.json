{
  "ConnectionStrings": {
    "Tracciabilita": "Server=192.168.23.1;Database=Tracciabilita;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;"
  },

  "Tracciabilita": {
    "_commento": "ApplicaVincoliSql: all'avvio crea (se mancano) i trigger e la sicurezza a livello di riga. AttivaSicurezzaRiga: va messa a true solo dopo il collaudo su Tracciabilita_Test. In produzione queste due voci vanno in appsettings.Production.json.",
    "ApplicaVincoliSql": false,
    "AttivaSicurezzaRiga": false
  },

  "Posta": {
    "_commento": "Posta in uscita via SMTP (Brevo). La password SMTP NON va qui: dotnet user-secrets set \"Posta:Password\" \"...\". Il mittente deve essere verificato.",
    "Host": "smtp-relay.brevo.com",
    "Porta": 587,
    "Utente": "mmaffei@mare-a.com",
    "MittenteEmail": "no-reply@mare-a.com",
    "MittenteNome": "Tracciato"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "log/tracciabilita-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
