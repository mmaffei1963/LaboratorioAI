@model LaboratorioAI.Tracciabilita.Web.Models.ModelloElencoSpedizioni
@{ ViewData["Titolo"] = "Spedizioni"; }
<div class="testa-pagina"><h1>Spedizioni ai clienti</h1><span class="nota">@Model.Totale trovate</span></div>
<p><a asp-action="Nuova" class="pulsante">Nuova spedizione</a> <a asp-controller="Clienti" asp-action="Index">Agenda clienti</a></p>
<form method="get" class="riga-modulo">
    <label>Cerca (cliente, documento o lotto)
        <input type="text" name="cerca" value="@Model.Cerca" /></label>
    <label>Dal <input type="date" name="dal" value="@Model.Dal?.ToString("yyyy-MM-dd")" /></label>
    <label>Al <input type="date" name="al" value="@Model.Al?.ToString("yyyy-MM-dd")" /></label>
    <button type="submit" class="piccolo">Cerca</button>
</form>
<table class="elenco">
    <thead><tr><th>Data</th><th>Cliente</th><th>Documento</th><th>Lotti</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model.Righe)
    {
        <tr>
            <td>@r.Data.ToString("dd/MM/yyyy")</td>
            <td><a asp-action="Scheda" asp-route-id="@r.IdSpedizione">@r.Cliente</a> @if (r.Annullata) { <span class="tag spento">annullata</span> }</td>
            <td>@r.NumeroDocumento</td>
            <td>@r.Lotti</td>
            <td><a asp-action="Scheda" asp-route-id="@r.IdSpedizione">Dettaglio</a></td>
        </tr>
    }
    @if (Model.Righe.Count == 0) { <tr><td colspan="5">Nessuna spedizione trovata.</td></tr> }
    </tbody>
</table>
@if (Model.Pagine > 1)
{
    <p>
        @if (Model.Pagina > 1)
        {
            <a asp-action="Index" asp-route-cerca="@Model.Cerca" asp-route-dal="@Model.Dal?.ToString("yyyy-MM-dd")" asp-route-al="@Model.Al?.ToString("yyyy-MM-dd")" asp-route-pagina="@(Model.Pagina - 1)">« Precedente</a>
        }
        Pagina @Model.Pagina di @Model.Pagine
        @if (Model.Pagina < Model.Pagine)
        {
            <a asp-action="Index" asp-route-cerca="@Model.Cerca" asp-route-dal="@Model.Dal?.ToString("yyyy-MM-dd")" asp-route-al="@Model.Al?.ToString("yyyy-MM-dd")" asp-route-pagina="@(Model.Pagina + 1)">Successiva »</a>
        }
    </p>
}
