@model List<LaboratorioAI.Dati.MonitorTemperature.Models.StoricoTemperatura>

@using System.Text.Json

@{
    ViewData["Title"] =
        "Monitor Controllo";

    string periodo =
        ViewBag.Periodo ?? "24h";

    string codiceSondaSelezionato =
        ViewBag.CodiceSonda ?? "TUTTE";

    DateTime? dataDa =
        ViewBag.DataDa as DateTime?;

    DateTime? dataA =
        ViewBag.DataA as DateTime?;

    bool filtroPersonalizzato =
        ViewBag.FiltroPersonalizzato ?? false;

    var sondeDisponibili =
        ViewBag.SondeDisponibili
        as List<string>
        ?? new List<string>();

    string? sondaSelezionataCorrente =
        ViewBag.SondaSelezionata as string;

    var storicoSelezionato =
        ViewBag.StoricoSelezionato
        as List<LaboratorioAI.Dati.MonitorTemperature.Models.StoricoTemperatura>;

    DateTime adesso =
        DateTime.Now;

    int minutiSoglia =
        90;

    var gruppi =
        Model
            .GroupBy(x => new
            {
                x.IdSonda,
                x.CodiceSonda,
                x.Apparecchiatura,
                x.CodiceApparecchiatura
            })
            .OrderBy(g =>
            {
                string numero =
                    g.Key.CodiceSonda
                        .Replace("T", "")
                        .Trim();

                return int.TryParse(
                    numero,
                    out int n)
                    ? n
                    : 9999;
            })
            .ToList();

    DateTime? dataMin =
        Model.Count > 0
            ? Model.Min(
                x => x.DataOra)
            : null;

    DateTime? dataMax =
        Model.Count > 0
            ? Model.Max(
                x => x.DataOra)
            : null;

    string testoPeriodo =
        "Nessun dato disponibile";

    if (
        dataMin.HasValue
        &&
        dataMax.HasValue)
    {
        testoPeriodo =
            dataMin.Value.ToString(
                "dd/MM/yyyy HH:mm")
            +
            " - "
            +
            dataMax.Value.ToString(
                "dd/MM/yyyy HH:mm");
    }

    string descrizioneFiltro;

    if (filtroPersonalizzato)
    {
        string da =
            dataDa.HasValue
                ? dataDa.Value.ToString(
                    "dd/MM/yyyy")
                : "inizio archivio";

        string a =
            dataA.HasValue
                ? dataA.Value.ToString(
                    "dd/MM/yyyy")
                : "oggi";

        descrizioneFiltro =
            $"Periodo personalizzato: {da} - {a}";
    }
    else
    {
        descrizioneFiltro =
            periodo switch
            {
                "24h" =>
                    "Ultime 24 ore",

                "48h" =>
                    "Ultime 48 ore",

                "7g" =>
                    "Ultimi 7 giorni",

                "30g" =>
                    "Ultimi 30 giorni",

                "tutto" =>
                    "Tutto lo storico",

                _ =>
                    "Periodo selezionato"
            };
    }
}

<style>

    @@page {
        size: A4 landscape;
        margin: 8mm;
    }

    @@media print {

        html,
        body {
            width: 100%;
            margin: 0 !important;
            padding: 0 !important;
            background: white !important;
        }

        .no-print {
            display: none !important;
        }

        .container-fluid {
            width: 100% !important;
            max-width: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        h1 {
            font-size: 20px !important;
            margin: 0 0 4px 0 !important;
        }

        p {
            font-size: 11px !important;
            margin-bottom: 6px !important;
        }

        .alert {
            font-size: 10px !important;
            padding: 5px 8px !important;
            margin-bottom: 6px !important;
        }

        .row {
            --bs-gutter-x: 8px !important;
            --bs-gutter-y: 8px !important;
        }

        .row > div {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .card {
            border: 1px solid #777 !important;
            box-shadow: none !important;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .card-header {
            padding: 5px 8px !important;
        }

        .card-body {
            padding: 6px 8px !important;
        }

        .card-body > div[style*="height: 230px"] {
            height: 165px !important;
        }

        .mt-2.small {
            font-size: 9px !important;
            line-height: 1.2 !important;
            margin-top: 4px !important;
        }

        .badge {
            font-size: 9px !important;
        }

        canvas {
            max-height: 165px !important;
        }
    }

</style>

<div class="container-fluid mt-4 px-4">

    <h1 class="mb-2">
        Monitor Controllo
    </h1>

    <p class="text-muted mb-3">
        Visualizzazione dei valori di controllo
        derivati dalle misure Econorma
    </p>

    <div class="alert alert-light border mb-3">

        <strong>
            Filtro attivo:
        </strong>

        @descrizioneFiltro

        <span class="mx-2">
            |
        </span>

        <strong>
            Sonda:
        </strong>

        @(codiceSondaSelezionato == "TUTTE"
            ? "Tutte"
            : codiceSondaSelezionato)

        <span class="mx-2">
            |
        </span>

        <strong>
            Periodo effettivamente visualizzato:
        </strong>

        @testoPeriodo

        <span class="mx-2">
            |
        </span>

        <strong>
            Misure:
        </strong>

        @Model.Count

    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3 no-print">

        <a asp-controller="Monitor" asp-area="MonitorTemperature"
           asp-action="Index"
           class="btn btn-secondary">

            Dashboard

        </a>

        <a asp-controller="Grafici" asp-area="MonitorTemperature"
           asp-action="Index"
           asp-route-periodo="@periodo"
           class="btn btn-outline-secondary">

            Monitor

        </a>

        <a asp-controller="MonitorControllo" asp-area="MonitorTemperature"
           asp-action="Index"
           asp-route-periodo="24h"
           asp-route-codiceSonda="@codiceSondaSelezionato"
           class="btn @(!filtroPersonalizzato && periodo == "24h" ? "btn-primary" : "btn-outline-primary")">

            24 ore

        </a>

        <a asp-controller="MonitorControllo" asp-area="MonitorTemperature"
           asp-action="Index"
           asp-route-periodo="48h"
           asp-route-codiceSonda="@codiceSondaSelezionato"
           class="btn @(!filtroPersonalizzato && periodo == "48h" ? "btn-primary" : "btn-outline-primary")">

            48 ore

        </a>

        <a asp-controller="MonitorControllo" asp-area="MonitorTemperature"
           asp-action="Index"
           asp-route-periodo="7g"
           asp-route-codiceSonda="@codiceSondaSelezionato"
           class="btn @(!filtroPersonalizzato && periodo == "7g" ? "btn-primary" : "btn-outline-primary")">

            7 giorni

        </a>

        <a asp-controller="MonitorControllo" asp-area="MonitorTemperature"
           asp-action="Index"
           asp-route-periodo="30g"
           asp-route-codiceSonda="@codiceSondaSelezionato"
           class="btn @(!filtroPersonalizzato && periodo == "30g" ? "btn-primary" : "btn-outline-primary")">

            30 giorni

        </a>

        <a asp-controller="MonitorControllo" asp-area="MonitorTemperature"
           asp-action="Index"
           asp-route-periodo="tutto"
           asp-route-codiceSonda="@codiceSondaSelezionato"
           class="btn @(!filtroPersonalizzato && periodo == "tutto" ? "btn-primary" : "btn-outline-primary")">

            Tutto

        </a>

        <button type="button"
                class="btn btn-outline-dark"
                onclick="window.print()">

            Stampa / PDF

        </button>

        <a asp-controller="MonitorControllo" asp-area="MonitorTemperature"
           asp-action="EsportaExcel"
           asp-route-periodo="@periodo"
           asp-route-codiceSonda="@codiceSondaSelezionato"
           asp-route-dataDa="@(dataDa.HasValue ? dataDa.Value.ToString("yyyy-MM-dd") : null)"
           asp-route-dataA="@(dataA.HasValue ? dataA.Value.ToString("yyyy-MM-dd") : null)"
           class="btn btn-outline-success no-print">

            Esporta Excel

        </a>

    </div>

    <div class="card mb-4 no-print">

        <div class="card-body">

            <form method="get"
                  asp-controller="MonitorControllo" asp-area="MonitorTemperature"
                  asp-action="Index"
                  class="row g-3 align-items-end">

                <input type="hidden"
                       name="periodo"
                       value="@periodo" />

                <div class="col-12 col-md-3">

                    <label class="form-label fw-bold"
                           for="codiceSonda">

                        Sonda

                    </label>

                    <select id="codiceSonda"
                            name="codiceSonda"
                            class="form-select">

                        <option value="TUTTE"
                                selected="@(codiceSondaSelezionato == "TUTTE")">

                            Tutte le sonde

                        </option>

                        @foreach (
                            string codice
                            in sondeDisponibili)
                        {
                            <option value="@codice"
                                    selected="@(codiceSondaSelezionato == codice)">

                                @codice

                            </option>
                        }

                    </select>

                </div>

                <div class="col-12 col-md-3">

                    <label class="form-label fw-bold"
                           for="dataDa">

                        Data inizio

                    </label>

                    <input type="date"
                           id="dataDa"
                           name="dataDa"
                           value="@(dataDa.HasValue ? dataDa.Value.ToString("yyyy-MM-dd") : "")"
                           class="form-control" />

                </div>

                <div class="col-12 col-md-3">

                    <label class="form-label fw-bold"
                           for="dataA">

                        Data fine

                    </label>

                    <input type="date"
                           id="dataA"
                           name="dataA"
                           value="@(dataA.HasValue ? dataA.Value.ToString("yyyy-MM-dd") : "")"
                           class="form-control" />

                </div>

                <div class="col-12 col-md-3">

                    <button type="submit"
                            class="btn btn-primary me-2">

                        Applica filtro

                    </button>

                    <a asp-controller="MonitorControllo" asp-area="MonitorTemperature"
                       asp-action="Index"
                       asp-route-periodo="24h"
                       class="btn btn-outline-secondary">

                        Azzera filtro

                    </a>

                </div>

            </form>

            <div class="small text-muted mt-3">

                Se imposti Data inizio e/o Data fine,
                il periodo personalizzato ha precedenza
                sui pulsanti rapidi.
                La data finale comprende tutta
                la giornata selezionata.

            </div>

        </div>

    </div>

    @if (gruppi.Count == 0)
    {
        <div class="alert alert-warning">

            Nessun dato disponibile
            con i filtri selezionati.

        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var gruppo in gruppi)
            {
                var misure =
                    gruppo
                        .OrderBy(
                            x => x.DataOra)
                        .ToList();

                var ultima =
                    misure.Last();

                double minutiDaUltima =
                    (
                        adesso
                        -
                        ultima.DataOra
                    )
                    .TotalMinutes;

                bool ferma =
                    minutiDaUltima
                    > minutiSoglia;

                bool allarme =
                    ultima.AllarmeCalcolato
                    != 0;

                string classeBordo =
                    allarme
                        ? "border-danger border-3"
                        : ferma
                            ? "border-warning border-3"
                            : "";

                string classeBadge =
                    allarme
                        ? "bg-danger"
                        : ferma
                            ? "bg-warning text-dark"
                            : "bg-success";

                string testoStato =
                    allarme
                        ? "ALLARME"
                        : ferma
                            ? "FERMA"
                            : "OK";

                string coloreTemperatura =
                    allarme
                        ? "#dc3545"
                        : ferma
                            ? "#ffc107"
                            : "#198754";

                string temperaturaUltima =
                    ultima.TemperaturaCorretta.HasValue
                        ? ultima.TemperaturaCorretta.Value.ToString("0.0")
                        : "-";

                string idCanvas =
                    "grafico_"
                    +
                    gruppo.Key.IdSonda;

                var datiGrafico =
                    misure
                        .Select(x => new
                        {
                            dataOra =
                                x.DataOra,

                            temperatura =
                                x.TemperaturaCorretta,

                            limiteMin =
                                x.LimiteMin,

                            limiteMax =
                                x.LimiteMax
                        })
                        .ToList();

                string json =
                    JsonSerializer.Serialize(
                        datiGrafico);


                <div class="col-12 col-md-6 col-lg-4 col-xl-3">

                    <a asp-controller="MonitorControllo" asp-area="MonitorTemperature"
                       asp-action="Index"
                       asp-route-periodo="@periodo"
                       asp-route-codiceSonda="@codiceSondaSelezionato"
                       asp-route-dataDa="@(dataDa.HasValue ? dataDa.Value.ToString("yyyy-MM-dd") : null)"
                       asp-route-dataA="@(dataA.HasValue ? dataA.Value.ToString("yyyy-MM-dd") : null)"
                       asp-route-sondaSelezionata="@gruppo.Key.CodiceSonda"
                       asp-fragment="tabella-storico"
                       class="text-decoration-none text-reset d-block"
                       title="Mostra lo storico dettagliato di @gruppo.Key.CodiceSonda">

                    <div class="card h-100 @classeBordo @(sondaSelezionataCorrente == gruppo.Key.CodiceSonda ? "border-primary border-3 shadow" : "")">

                        <div class="card-header">

                            <div class="d-flex justify-content-between align-items-start gap-2">

                                <div>

                                    <div class="fw-bold fs-5">

                                        @gruppo.Key.CodiceSonda

                                    </div>

                                    <div class="small text-muted">

                                        @gruppo.Key.Apparecchiatura

                                    </div>

                                </div>

                                <span class="badge @classeBadge">

                                    @testoStato

                                </span>

                            </div>

                        </div>

                        <div class="card-body">

                            <div style="height: 230px;">

                                <canvas id="@idCanvas" data-colore="@coloreTemperatura"></canvas>

                            </div>

                            <div class="mt-2 small">

                                <strong>
                                    Ultima:
                                </strong>

                                @ultima.DataOra.ToString(
                                    "dd/MM/yyyy HH:mm")

                                <br />

                                <strong>
                                    Temperatura:
                                </strong>

                                <span class="text-primary fw-semibold">

                                    @temperaturaUltima °C

                                </span>

                                @if (
                                    ultima.LimiteMin.HasValue
                                    &&
                                    ultima.LimiteMax.HasValue)
                                {
                                    <br />

                                    <strong>
                                        Limiti:
                                    </strong>

                                    <span class="text-danger fw-semibold">

                                        @ultima.LimiteMin.Value.ToString("0.0")

                                    </span>

                                    <span>
                                        /
                                    </span>

                                    <span style="color:#fd7e14;"
                                          class="fw-semibold">

                                        @ultima.LimiteMax.Value.ToString("0.0")

                                    </span>

                                    <span>
                                        °C
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                    </a>

                </div>

                <script type="application/json"
                        id="dati_@gruppo.Key.IdSonda">

                    @Html.Raw(json)

                </script>
            }

        </div>
    }

</div>

@if (sondaSelezionataCorrente != null)
{
    <div id="tabella-storico" class="card mt-4">

        <div class="card-header d-flex justify-content-between align-items-center">

            <strong>
                Storico dettagliato — sonda @sondaSelezionataCorrente
            </strong>

            <a asp-controller="MonitorControllo" asp-area="MonitorTemperature"
               asp-action="Index"
               asp-route-periodo="@periodo"
               asp-route-codiceSonda="@codiceSondaSelezionato"
               asp-route-dataDa="@(dataDa.HasValue ? dataDa.Value.ToString("yyyy-MM-dd") : null)"
               asp-route-dataA="@(dataA.HasValue ? dataA.Value.ToString("yyyy-MM-dd") : null)"
               class="btn btn-sm btn-outline-secondary no-print">

                Chiudi storico

            </a>

        </div>

        <div class="card-body">

            @if (storicoSelezionato == null || storicoSelezionato.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    Nessuna misura disponibile nel periodo selezionato per questa sonda.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-bordered align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Data/Ora</th>
                                <th>Sonda</th>
                                <th>Temperatura grezza</th>
                                <th>Offset</th>
                                <th>Temperatura corretta</th>
                                <th>Limite Min</th>
                                <th>Limite Max</th>
                                <th>Stato</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var riga in storicoSelezionato)
                            {
                                <tr class="@(riga.AllarmeCalcolato == 1 ? "table-danger" : "")">
                                    <td>@riga.DataOra.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>@riga.CodiceSonda</td>
                                    <td>@riga.TemperaturaGrezza?.ToString("0.000")</td>
                                    <td>@riga.OffsetTemperatura?.ToString("0.000")</td>
                                    <td>@riga.TemperaturaCorretta?.ToString("0.000")</td>
                                    <td>@riga.LimiteMin?.ToString("0.00")</td>
                                    <td>@riga.LimiteMax?.ToString("0.00")</td>
                                    <td>
                                        @if (riga.AllarmeCalcolato == 1)
                                        {
                                            <span class="badge bg-danger">ALLARME</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">OK</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>
}


@if (gruppi.Count > 0)
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const periodo =
            "@periodo";

        const filtroPersonalizzato =
            @filtroPersonalizzato.ToString().ToLowerInvariant();

        function formattaEtichetta(dataOra) {

            const d =
                new Date(
                    dataOra
                );

            if (
                !filtroPersonalizzato
                &&
                periodo === "24h"
            ) {

                return d.toLocaleTimeString(
                    "it-IT",
                    {
                        hour:
                            "2-digit",

                        minute:
                            "2-digit"
                    }
                );
            }

            const giorno =
                d.toLocaleDateString(
                    "it-IT",
                    {
                        day:
                            "2-digit",

                        month:
                            "2-digit"
                    }
                );

            const ora =
                d.toLocaleTimeString(
                    "it-IT",
                    {
                        hour:
                            "2-digit",

                        minute:
                            "2-digit"
                    }
                );

            return giorno
                + " "
                + ora;
        }

        document
            .querySelectorAll(
                'script[id^="dati_"]'
            )
            .forEach(
                function(elementoDati) {

                    const idSonda =
                        elementoDati.id
                            .replace(
                                "dati_",
                                ""
                            );

                    const canvas =
                        document.getElementById(
                            "grafico_"
                            + idSonda
                        );

                    if (!canvas) {

                        return;
                    }

                    const coloreTemperatura =
                        canvas.dataset.colore
                        || "#0047AB";

                    const dati =
                        JSON.parse(
                            elementoDati.textContent
                        );

                    if (
                        !dati
                        ||
                        dati.length === 0)
                    {
                        return;
                    }

                    const labels =
                        dati.map(
                            function(x) {

                                return formattaEtichetta(
                                    x.dataOra
                                );
                            }
                        );

                    const temperature =
                        dati.map(
                            function(x) {

                                return x.temperatura;
                            }
                        );

                    const limiteMin =
                        dati.map(
                            function(x) {

                                return x.limiteMin;
                            }
                        );

                    const limiteMax =
                        dati.map(
                            function(x) {

                                return x.limiteMax;
                            }
                        );

                    new Chart(
                        canvas,
                        {
                            type:
                                "line",

                            data:
                            {
                                labels:
                                    labels,

                                datasets:
                                [
                                    {
                                        label:
                                            "Temperatura",

                                        data:
                                            temperature,

                                        borderColor:
                                            coloreTemperatura,

                                        backgroundColor:
                                            coloreTemperatura,

                                        borderWidth:
                                            4,

                                        pointRadius:
                                            3,

                                        pointBackgroundColor:
                                            coloreTemperatura,

                                        pointBorderColor:
                                            coloreTemperatura,

                                        pointHoverRadius:
                                            6,

                                        tension:
                                            0.15,

                                        fill:
                                            false
                                    },

                                    {
                                        label:
                                            "Limite minimo",

                                        data:
                                            limiteMin,

                                        borderColor:
                                            "#dc3545",

                                        backgroundColor:
                                            "#dc3545",

                                        borderWidth:
                                            2.5,

                                        borderDash:
                                            [7, 4],

                                        pointRadius:
                                            0,

                                        fill:
                                            false
                                    },

                                    {
                                        label:
                                            "Limite massimo",

                                        data:
                                            limiteMax,

                                        borderColor:
                                            "#fd7e14",

                                        backgroundColor:
                                            "#fd7e14",

                                        borderWidth:
                                            2.5,

                                        borderDash:
                                            [7, 4],

                                        pointRadius:
                                            0,

                                        fill:
                                            false
                                    }
                                ]
                            },

                            options:
                            {
                                responsive:
                                    true,

                                maintainAspectRatio:
                                    false,

                                interaction:
                                {
                                    mode:
                                        "index",

                                    intersect:
                                        false
                                },

                                plugins:
                                {
                                    legend:
                                    {
                                        display:
                                            false
                                    },

                                    tooltip:
                                    {
                                        callbacks:
                                        {
                                            title:
                                                function(context) {

                                                    if (
                                                        !context
                                                        ||
                                                        context.length === 0)
                                                    {
                                                        return "";
                                                    }

                                                    const indice =
                                                        context[0]
                                                            .dataIndex;

                                                    const data =
                                                        new Date(
                                                            dati[indice]
                                                                .dataOra
                                                        );

                                                    return data
                                                        .toLocaleString(
                                                            "it-IT",
                                                            {
                                                                day:
                                                                    "2-digit",

                                                                month:
                                                                    "2-digit",

                                                                year:
                                                                    "numeric",

                                                                hour:
                                                                    "2-digit",

                                                                minute:
                                                                    "2-digit",

                                                                second:
                                                                    "2-digit"
                                                            }
                                                        );
                                                },

                                            label:
                                                function(context) {

                                                    if (
                                                        context.dataset.label
                                                        !== "Temperatura")
                                                    {
                                                        return null;
                                                    }

                                                    if (
                                                        context.parsed.y
                                                        === null
                                                        ||
                                                        context.parsed.y
                                                        === undefined)
                                                    {
                                                        return "Temperatura: -";
                                                    }

                                                    return "Temperatura: "
                                                        +
                                                        Number(
                                                            context.parsed.y
                                                        )
                                                        .toFixed(1)
                                                        +
                                                        " °C";
                                                }
                                        }
                                    }
                                },

                                scales:
                                {
                                    x:
                                    {
                                        ticks:
                                        {
                                            maxTicksLimit:
                                                filtroPersonalizzato
                                                    ? 8
                                                    : periodo === "7g"
                                                        ? 7
                                                        : 6,

                                            maxRotation:
                                                filtroPersonalizzato
                                                    ? 45
                                                    : 0,

                                            minRotation:
                                                filtroPersonalizzato
                                                    ? 45
                                                    : 0
                                        }
                                    },

                                    y:
                                    {
                                        title:
                                        {
                                            display:
                                                true,

                                            text:
                                                "°C"
                                        }
                                    }
                                }
                            }
                        }
                    );
                }
            );

    </script>
}
