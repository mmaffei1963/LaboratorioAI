@model LaboratorioAI.Web.Controllers.ModelloFerie
@using LaboratorioAI.Core.Presenze
@{
    var oggi = FusoPresenze.GiornoLocale(DateTime.UtcNow);
    var sedeRotta = Model.IdSede;
}

<div class="barra-strumenti">
    <div>
        <h1>Calendario ferie @Model.Anno</h1>
        <p class="sottotitolo">Ferie e permessi di tutti, per vedere chi è assente nello stesso periodo. Le altre assenze non compaiono. Sotto ogni mese, la riga «Assenti» dice quanti sono fuori ogni giorno.</p>
    </div>
    <div class="azioni">
        <a class="pulsante secondario" asp-action="Ferie" asp-route-anno="@(Model.Anno - 1)" asp-route-sede="@sedeRotta">&larr; @(Model.Anno - 1)</a>
        <a class="pulsante secondario" asp-action="Ferie" asp-route-anno="@(Model.Anno + 1)" asp-route-sede="@sedeRotta">@(Model.Anno + 1) &rarr;</a>
        <a class="pulsante" asp-action="Assenza">Nuova assenza (ferie, permessi)</a>
        <a class="pulsante secondario" asp-action="Prospetto">Prospetto mensile</a>
    </div>
</div>

<partial name="_Messaggi" />

<form method="get" asp-action="Ferie" class="riquadro">
    <input type="hidden" name="anno" value="@Model.Anno" />
    <label>Sede
        <select name="sede" onchange="this.form.submit()">
            <option value="">tutte</option>
            @foreach (var s in Model.Sedi)
            {
                <option value="@s.IdSede" selected="@(Model.IdSede == s.IdSede)">@s.Nome</option>
            }
        </select>
    </label>
</form>

@if (Model.Dati.Lavoratori.Count == 0)
{
    <section class="riquadro"><p class="sottotesto">Nessun lavoratore da mostrare.</p></section>
}
else
{
    for (var mese = 1; mese <= 12; mese++)
    {
        var giorni = MotoreCalcoloPresenze.GiorniMese(Model.Anno, mese).ToList();
        var assenti = new int[giorni.Count];
        <section class="riquadro">
            <div class="tabella-scorrevole">
                <table class="tabella" style="font-size:0.78rem;border-collapse:collapse">
                    <thead>
                        <tr>
                            <th style="text-align:right;color:#003399">@MotoreCalcoloPresenze.Mesi[mese - 1]</th>
                            @foreach (var d in giorni)
                            {
                                var fine = d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                                <th style="text-align:center;padding:2px 3px;@(fine ? "background:#e8eef9;color:#000" : "")@(d == oggi ? ";outline:2px solid #b00" : "")">
                                    <div>@MotoreCalcoloPresenze.GiorniBrevi[MotoreCalcoloPresenze.IndiceGiornoSettimana(d)]</div>
                                    <div>@d.Day</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var l in Model.Dati.Lavoratori)
                    {
                        var calcolo = new LavoratorePresenze(l.Cognome, l.Colore, l.OreContratto(), l.AttivoDal);
                        var scuro = ProspettoPresenze.ColoreScuro(l.Colore);
                        Model.Dati.Assenze.TryGetValue(l.IdLavoratore, out var assenzeLavoratore);
                        Model.Dati.CalendarioPerSede.TryGetValue(l.IdSede, out var voci);
                        <tr>
                            <td style="text-align:center;font-weight:600;padding:2px 8px;border:1px solid #000;background:@l.Colore;color:@(scuro ? "#fff" : "#000")">@l.Cognome</td>
                            @for (var i = 0; i < giorni.Count; i++)
                            {
                                var d = giorni[i];
                                IReadOnlyList<AssenzaGiorno> delGiorno = Array.Empty<AssenzaGiorno>();
                                if (assenzeLavoratore is not null && assenzeLavoratore.TryGetValue(d, out var trovate)) { delGiorno = trovate; }
                                VoceCalendario? voce = null;
                                if (voci is not null && voci.TryGetValue(d, out var v)) { voce = v; }
                                var c = CalendarioFeriePresenze.Cella(calcolo, d, delGiorno, voce);
                                if (CalendarioFeriePresenze.Assente(delGiorno)) { assenti[i]++; }
                                var stile = "text-align:center;padding:2px 3px;border:1px solid #000;min-width:1.9rem";
                                if (c?.Sfondo is string sfondo) { stile += ";background:" + ProspettoPresenze.ColoreHtml(sfondo); }
                                if (c is not null && c.Grassetto) { stile += ";font-weight:700"; }
                                if (c is not null && ProspettoPresenze.ColoreCarattere(c, l.Colore) is string car) { stile += ";color:" + ProspettoPresenze.ColoreHtml(car); }
                                var testo = ProspettoPresenze.TestoCella(c);
                                <td style="@stile" title="@c?.Nota">@(testo.Length == 0 ? " " : testo)</td>
                            }
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr style="font-weight:700;color:#003399">
                            <td style="text-align:center;border:1px solid #000;padding:2px 8px">Assenti</td>
                            @foreach (var n in assenti)
                            {
                                <td style="text-align:center;border:1px solid #000;padding:2px 3px;@(n >= 2 ? "background:#ffe0e0;color:#b42318" : "")">@(n == 0 ? " " : n.ToString())</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>
    }
    <section class="riquadro">
        <p class="sottotesto">
            Il numero nella cella indica le ore di ferie o permesso (passa il mouse per sapere quale).
            <span style="background:#ffff00;border:1px solid #000;padding:0 0.5rem">FS / FE</span> fine settimana e festività ·
            <span style="background:#ff0000;border:1px solid #000;padding:0 0.5rem;font-weight:700">8</span> chiusura aziendale ·
            nella riga «Assenti» i giorni con due o più persone fuori sono evidenziati.
            Per inserire le tue ferie usa «Nuova assenza»: l'inserimento riguarda solo le tue presenze.
        </p>
    </section>
}
