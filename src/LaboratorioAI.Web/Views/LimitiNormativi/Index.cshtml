@{
    var puoValidare = ViewData["PuoValidare"] is true;
}
@* Limiti normativi (17/10/2026, fase 1a): schede limite e fonti ufficiali. Procedura limiti normativi Rev. 0. *@

<style>
    .lim-schede { display:flex; gap:0.4rem; margin-bottom:0.8rem; flex-wrap:wrap }
    .lim-schede button[aria-selected=true] { background: var(--rosso, #b00); color: #fff; border-color: transparent }
    .lim-stato { display:inline-block; padding:1px 8px; border-radius:10px; font-size:.75rem; font-weight:600; white-space:nowrap }
    .lim-stato-1 { background:#FEF3C7; color:#7a5b00 }     /* Proposta */
    .lim-stato-2 { background:#EBF7EF; color:#1a7f37 }     /* Validata */
    .lim-stato-3 { background:#FDE7D7; color:#A6460A }     /* Da riverificare */
    .lim-stato-4 { background:#F3F4F6; color:#6B7280; text-decoration: line-through }
    .lim-stato-5 { background:#F3F4F6; color:#6B7280 }
    .lim-griglia { display:grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap:0.5rem 0.8rem }
    .lim-griglia label, .lim-largo label { display:flex; flex-direction:column; font-size:.82rem; gap:2px }
    .lim-largo { display:grid; gap:0.5rem; margin-top:0.5rem }
    .lim-citazione { background:#F8FAFC; border-left:3px solid #94A3B8; padding:0.5rem 0.8rem; white-space:pre-wrap; font-size:.85rem }
    dialog.lim { max-width: 58rem; width: 96%; border:1px solid #ccc; border-radius:0.5rem; padding:1rem 1.2rem }
    .lim-abb { display:flex; flex-wrap:wrap; gap:0.3rem; margin-top:0.3rem }
    .lim-abb span { background:#EEF2FF; color:#3730A3; border-radius:10px; padding:1px 8px; font-size:.78rem }
    .lim-abb button { border:none; background:none; color:#b00; cursor:pointer; padding:0 0 0 4px }
    .lim-versioni td, .lim-versioni th { padding:4px 8px !important }
    tr.cliccabile { cursor:pointer }
    @@media (max-width: 640px) { dialog.lim { padding: 0.8rem } }
</style>

<div class="barra-strumenti">
    <div>
        <h1>Limiti normativi</h1>
        <p class="sottotitolo">Schede limite ricavate dalle fonti ufficiali (proposte dall'AI o inserite a mano) e validate da una persona diversa da chi le ha proposte. Solo le schede <strong>validate</strong> produrranno segnalazioni in «Da Validare» (fase 1b).</p>
    </div>
</div>

<div class="lim-schede" role="tablist">
    <button class="pulsante pulsante-tenue" role="tab" aria-selected="true" data-scheda="schede">Schede limite</button>
    <button class="pulsante pulsante-tenue" role="tab" aria-selected="false" data-scheda="fonti">Fonti</button>
    <button class="pulsante pulsante-tenue" role="tab" aria-selected="false" data-scheda="verifica">Verifica schede validate</button>
    <button class="pulsante pulsante-tenue" role="tab" aria-selected="false" data-scheda="categorie">Categorie e matrici</button>
    <button class="pulsante pulsante-tenue" role="tab" aria-selected="false" data-scheda="tempi">Tempi massimi</button>
</div>

<section class="riquadro" id="pannello-schede">
    <div class="azioni-filtri" style="display:flex;gap:0.8rem;flex-wrap:wrap;align-items:flex-end">
        <label>Famiglia <select id="f-famiglia"><option value="">tutte</option></select></label>
        <label>Stato <select id="f-stato"><option value="">tutti (tranne respinte e superate)</option></select></label>
        <label class="casella"><input type="checkbox" id="f-storico" /> mostra anche respinte e superate</label>
        <label class="casella" title="Mostra sotto ogni scheda citazione, condizioni e parametri ArcLab: si controlla e si valida dalla tabella, senza aprire le schede"><input type="checkbox" id="f-rapida" /> validazione rapida</label>
        <label>Ordina <select id="f-ordine"><option value="parametro">per parametro (doppioni vicini)</option><option value="codice">per codice</option></select></label>
        <input type="search" id="f-testo" placeholder="cerca parametro, codice, fonte, riferimento" style="min-width:16rem" />
        @if (puoValidare) { <button class="pulsante" id="btn-nuova" type="button">Nuova scheda</button> }
        <span class="sottotesto" id="stato-schede"></span>
    </div>
    @if (puoValidare)
    {
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;margin-top:0.6rem">
            <button class="pulsante pulsante-tenue" type="button" id="sel-tutte">Seleziona le visibili</button>
            <button class="pulsante pulsante-tenue" type="button" id="sel-nessuna">Togli selezione</button>
            <span class="sottotesto">si selezionano solo le schede «Proposta» o «Da riverificare»; con «validazione rapida» controlli citazione e parametri ArcLab direttamente in tabella</span>
        </div>
        <div id="barra-selezione" style="display:none;gap:0.5rem;flex-wrap:wrap;align-items:center;margin-top:0.5rem;padding:0.5rem 0.7rem;background:#FEF3C7;border-radius:6px">
            <strong id="sel-conta"></strong>
            <input id="sel-motivo" maxlength="1000" placeholder="nota (per respingere: motivo, es. «doppione di ACQ-012»)" style="flex:1;min-width:18rem" />
            <button class="pulsante" type="button" id="sel-valida" style="background:#1a7f37;border-color:#1a7f37">Valida le selezionate</button>
            <button class="pulsante" type="button" id="sel-respingi">Respingi le selezionate</button>
            <span class="sottotesto" id="sel-msg"></span>
        </div>
    }
    <div class="tabella-scorrevole" style="margin-top:0.6rem">
        <table class="tabella" id="tabella-schede">
            <thead><tr><th></th><th>Codice</th><th>Parametro</th><th>Matrice / categoria</th><th>Limite</th><th>Tipo</th><th>Stato</th><th>Abbinati</th><th>Fonte</th><th>Proposta da</th></tr></thead>
            <tbody><tr><td colspan="10" class="sottotesto">Caricamento…</td></tr></tbody>
        </table>
    </div>
    <p class="nota">«×2», «×3»: stesso parametro in più schede (possibili doppioni, ad esempio da due fonti o da due estrazioni). «Abbinati» = parametri ArcLab collegati alla scheda: senza abbinamenti la scheda non può segnalare nulla. Chi propone o corregge una scheda non può validarla.</p>
</section>

<section class="riquadro" id="pannello-fonti" hidden>
    <div style="display:flex;gap:0.6rem;flex-wrap:wrap;align-items:center">
        @if (puoValidare)
        {
            <button class="pulsante" id="btn-fase1" type="button">Aggiungi le fonti della fase 1</button>
            <button class="pulsante pulsante-tenue" id="btn-nuova-fonte" type="button">Nuova fonte</button>
        }
        <span class="sottotesto" id="stato-fonti"></span>
    </div>
    <div class="tabella-scorrevole" style="margin-top:0.6rem">
        <table class="tabella" id="tabella-fonti">
            <thead><tr><th>Famiglia</th><th>Fonte</th><th>Ultima verifica</th><th>Versioni salvate</th><th></th></tr></thead>
            <tbody><tr><td colspan="5" class="sottotesto">Caricamento…</td></tr></tbody>
        </table>
    </div>
    <p class="nota">«Scarica» legge il testo vigente dall'indirizzo ufficiale; se il sito non lo consente, salva la pagina o il PDF dal browser e usa «Carica file». Se il testo non è cambiato non si crea una nuova versione. «Estrai con AI» legge la versione e propone le schede: ogni proposta deve citare parola per parola il testo, altrimenti è scartata.</p>
</section>

<section class="riquadro" id="pannello-verifica" hidden>
    <p style="margin-top:0">Secondo controllo sulle schede <strong>validate</strong> («quattro occhi»). I controlli automatici sono immediati e gratuiti
        (valore nella citazione, unità, parametri ArcLab, tipo di limite, contraddizioni). La revisione con l'AI rilegge il testo ufficiale salvato e giudica
        ogni scheda conforme, dubbia o errata, citando la norma. Nessuna scheda viene modificata: i rilievi si chiudono con una nota, dopo aver
        corretto la scheda se serve.</p>
    @if (puoValidare)
    {
        <div style="display:flex;gap:0.6rem;flex-wrap:wrap;align-items:center">
            <button class="pulsante" type="button" id="ver-automatica">Esegui i controlli automatici</button>
            <span class="sottotesto" id="stato-verifica"></span>
        </div>
    }
    <h3 style="margin:1rem 0 0.4rem">Revisione con l'AI, per fonte</h3>
    <div class="tabella-scorrevole">
        <table class="tabella" id="tabella-ver-fonti">
            <thead><tr><th>Fonte</th><th class="numerico">Schede validate</th><th>Ultima revisione</th><th></th></tr></thead>
            <tbody><tr><td colspan="4" class="sottotesto">Caricamento…</td></tr></tbody>
        </table>
    </div>
    <h3 style="margin:1rem 0 0.4rem">Rilievi</h3>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap;align-items:flex-end">
        <label>Mostra <select id="ver-giro"><option value="">tutti i rilievi aperti</option></select></label>
        <label class="casella"><input type="checkbox" id="ver-chiusi" /> anche quelli chiusi</label>
        <a class="pulsante pulsante-tenue" id="ver-excel" href="#" hidden>Scarica Excel del giro</a>
    </div>
    @if (puoValidare)
    {
        <div id="ver-barra" style="display:none;gap:0.5rem;flex-wrap:wrap;align-items:center;margin-top:0.5rem;padding:0.5rem 0.7rem;background:#FEF3C7;border-radius:6px">
            <strong id="ver-conta"></strong>
            <input id="ver-nota" maxlength="1000" placeholder="nota obbligatoria, es. «verificato sul testo: corretto» o «scheda corretta, nuova versione»" style="flex:1;min-width:18rem" />
            <button class="pulsante" type="button" id="ver-chiudi">Chiudi i rilievi selezionati</button>
            <span class="sottotesto" id="ver-msg"></span>
        </div>
    }
    <div class="tabella-scorrevole" style="margin-top:0.6rem">
        <table class="tabella" id="tabella-rilievi">
            <thead><tr><th></th><th>Esito</th><th>Controllo</th><th>Scheda</th><th>Parametro / categoria</th><th>Limite</th><th>Motivo</th><th>Stato</th></tr></thead>
            <tbody><tr><td colspan="8" class="sottotesto">Caricamento…</td></tr></tbody>
        </table>
    </div>
    <h3 style="margin:1rem 0 0.4rem">Giri di verifica</h3>
    <div class="tabella-scorrevole">
        <table class="tabella" id="tabella-giri">
            <thead><tr><th>N.</th><th>Tipo</th><th>Fonte</th><th>Richiesto</th><th>Esito</th><th></th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
</section>

<section class="riquadro" id="pannello-categorie" hidden>
    <p style="margin-top:0">Per gli <strong>Alimenti</strong> il limite dipende dalla categoria della norma (es. «alimenti pronti favorevoli a Listeria»), mentre
        ArcLab conosce solo la <strong>matrice</strong> del campione. Qui si abbina ogni matrice ArcLab alle sue categorie: l'AI propone, una persona conferma.
        Per Legionella, Acque e Molluschi non serve: basta la famiglia della matrice.</p>
    @if (puoValidare)
    {
        <div style="display:flex;gap:0.6rem;flex-wrap:wrap;align-items:center">
            <button class="pulsante" type="button" id="cat-proponi">Proponi abbinamenti con l'AI</button>
            <span class="sottotesto" id="stato-categorie"></span>
        </div>
    }
    <details style="margin-top:0.8rem">
        <summary><strong>Categorie normative</strong> <span class="sottotesto" id="cat-conta"></span></summary>
        <div class="tabella-scorrevole" style="margin-top:0.4rem">
            <table class="tabella" id="tabella-categorie">
                <thead><tr><th>Categoria della norma</th><th>Famiglia</th><th>Parametri</th><th class="numerico">Schede validate</th><th class="numerico">Matrici</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
    <h3 style="margin:1rem 0 0.4rem">Matrici ArcLab degli alimenti (ultimi 3 anni)</h3>
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap;align-items:flex-end">
        <label>Mostra <select id="cat-filtro">
            <option value="dafare">da confermare o senza abbinamento</option>
            <option value="proposte">con proposte da confermare</option>
            <option value="senza">senza abbinamento</option>
            <option value="tutte">tutte</option>
        </select></label>
        <input type="search" id="cat-cerca" placeholder="cerca matrice o categoria" style="min-width:16rem" />
        @if (puoValidare)
        {
            <button class="pulsante pulsante-tenue" type="button" id="cat-sel-tutte">Seleziona le visibili</button>
            <button class="pulsante" type="button" id="cat-conferma" style="background:#1a7f37;border-color:#1a7f37">Conferma le proposte delle selezionate</button>
        }
        <span class="sottotesto" id="cat-msg"></span>
    </div>
    <div class="tabella-scorrevole" style="margin-top:0.6rem">
        <table class="tabella" id="tabella-matrici">
            <thead><tr><th></th><th>Matrice ArcLab</th><th class="numerico">Prove</th><th>Categorie</th><th></th></tr></thead>
            <tbody><tr><td colspan="5" class="sottotesto">Caricamento…</td></tr></tbody>
        </table>
    </div>
    <p class="nota">Verde = confermato, giallo = proposto dall'AI (passa il mouse per la motivazione). ✓ conferma, ✕ toglie. «Nessuna categoria» = la matrice non ha limiti degli alimenti (non verrà segnalata in grigio).</p>
</section>

<section class="riquadro" id="pannello-tempi" hidden>
    <p style="margin-top:0">Tempo massimo tra la <strong>ricezione</strong> del campione e l'<strong>inizio della prova</strong>: se superato, in «Da Validare»
        la prova è segnalata in <strong>viola</strong>. Una riga per famiglia vale per tutti i parametri; una riga per un singolo parametro ArcLab prevale su quella
        della famiglia. Senza righe attive il controllo non si fa. Le righe non si cancellano: si disattivano.</p>
    @if (puoValidare)
    {
        <div style="display:flex;gap:0.6rem;flex-wrap:wrap;align-items:center">
            <button class="pulsante" type="button" id="tm-nuovo">Nuova riga</button>
            <span class="sottotesto" id="tm-msg"></span>
        </div>
    }
    else
    {
        <span class="sottotesto" id="tm-msg"></span>
    }
    <div class="tabella-scorrevole" style="margin-top:0.6rem">
        <table class="tabella" id="tabella-tempi">
            <thead><tr><th>Famiglia</th><th>Parametro</th><th class="numerico">Ore massime</th><th>Nota</th><th>Stato</th><th>Modificata</th><th></th></tr></thead>
            <tbody><tr><td colspan="7" class="sottotesto">Caricamento…</td></tr></tbody>
        </table>
    </div>
</section>

@* Tempo massimo *@
<dialog class="lim" id="dlg-tempo" style="max-width:34rem">
    <h3 style="margin-top:0" id="dt-titolo">Tempo massimo</h3>
    <div class="lim-largo">
        <label>Famiglia <select id="dt-famiglia"></select></label>
        <label>Parametro ArcLab (vuoto = tutta la famiglia)
            <input id="dt-parametro" list="dt-elenco-par" placeholder="scrivi per cercare, vuoto = tutta la famiglia" autocomplete="off" />
            <datalist id="dt-elenco-par"></datalist>
        </label>
        <label>Ore massime dalla ricezione all'inizio della prova <input id="dt-ore" type="number" min="1" max="720" step="1" /></label>
        <label>Nota (es. riferimento normativo o del metodo) <input id="dt-nota" maxlength="500" /></label>
        <label class="casella" style="flex-direction:row;align-items:center"><input type="checkbox" id="dt-attivo" /> attiva</label>
    </div>
    <p class="sottotesto" id="dt-msg"></p>
    <div style="display:flex;gap:0.6rem;justify-content:flex-end">
        <button class="pulsante pulsante-tenue" type="button" data-chiudi>Annulla</button>
        <button class="pulsante" type="button" id="dt-salva">Salva</button>
    </div>
</dialog>

@* Dettaglio scheda *@
<dialog class="lim" id="dlg-scheda">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem">
        <h3 style="margin-top:0" id="ds-titolo">Scheda</h3>
        <button class="pulsante pulsante-tenue" type="button" data-chiudi>Chiudi</button>
    </div>
    <div id="ds-corpo"></div>
    <div id="ds-azioni" style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:flex-end;margin-top:0.8rem"></div>
    <p class="sottotesto" id="ds-msg"></p>
</dialog>

@* Modifica / nuova scheda *@
<dialog class="lim" id="dlg-modifica">
    <h3 style="margin-top:0" id="dm-titolo">Nuova scheda</h3>
    <div class="lim-griglia">
        <label>Famiglia <select id="dm-famiglia"></select></label>
        <label>Parametro (come nella norma) <input id="dm-parametro" maxlength="300" /></label>
        <label>Tipo di limite <select id="dm-tipo"></select></label>
        <label>Confronto <select id="dm-operatore"></select></label>
        <label>Valore <input id="dm-valore" inputmode="decimal" /></label>
        <label>Valore massimo (intervallo) <input id="dm-valoremax" inputmode="decimal" /></label>
        <label>Unità (per «assente in»: la quantità, es. 25 g) <input id="dm-unita" maxlength="50" /></label>
        <label>Regola di valutazione <select id="dm-regola"></select></label>
        <label>n <input id="dm-n" inputmode="numeric" /></label>
        <label>c <input id="dm-c" inputmode="numeric" /></label>
        <label>m <input id="dm-m" inputmode="decimal" /></label>
        <label>M <input id="dm-mm" inputmode="decimal" /></label>
        <label>Valido dal <input type="date" id="dm-dal" /></label>
        <label>Valido al <input type="date" id="dm-al" /></label>
    </div>
    <div class="lim-largo">
        <label>Matrice / categoria (come nella norma) <input id="dm-matrice" maxlength="500" /></label>
        <label>Condizioni di applicazione <input id="dm-condizioni" maxlength="1000" /></label>
        <label>Riferimento (norma, articolo, allegato, punto) <input id="dm-riferimento" maxlength="500" /></label>
        <label>Citazione testuale della norma <textarea id="dm-citazione" rows="3" maxlength="4000"></textarea></label>
        <label>Testo della segnalazione <input id="dm-segnalazione" maxlength="500" placeholder="es. Superato il limite di 1.000 UFC/L: prevista la revisione della valutazione del rischio" /></label>
        <label>Note <textarea id="dm-note" rows="2" maxlength="2000"></textarea></label>
        <div>
            <label>Parametri ArcLab abbinati
                <span style="display:flex;gap:0.4rem"><input id="dm-cerca-par" list="dm-elenco-par" placeholder="scrivi per cercare un parametro ArcLab" style="flex:1" /><button class="pulsante pulsante-tenue" type="button" id="dm-aggiungi-par">Aggiungi</button></span>
            </label>
            <datalist id="dm-elenco-par"></datalist>
            <div class="lim-abb" id="dm-abbinamenti"></div>
            <p class="sottotesto" style="margin:0.2rem 0 0">Elenco dei parametri misurati negli ultimi 3 anni nelle matrici della famiglia scelta.</p>
        </div>
    </div>
    <p class="sottotesto" id="dm-msg"></p>
    <div style="display:flex;gap:0.5rem;justify-content:flex-end">
        <button class="pulsante pulsante-tenue" type="button" data-chiudi>Annulla</button>
        <button class="pulsante" type="button" id="dm-salva">Salva come «Proposta»</button>
    </div>
</dialog>

@* Fonte *@
<dialog class="lim" id="dlg-fonte" style="max-width:40rem">
    <h3 style="margin-top:0" id="df-titolo">Fonte</h3>
    <div class="lim-largo">
        <label>Famiglia <select id="df-famiglia"></select></label>
        <label>Titolo <input id="df-titolo-in" maxlength="300" /></label>
        <label>Ente / banca dati <input id="df-ente" maxlength="150" /></label>
        <label>Tipo <select id="df-tipo"></select></label>
        <label>Indirizzo ufficiale (https://…) <input id="df-url" maxlength="1000" /></label>
        <label>Note <textarea id="df-note" rows="3" maxlength="2000"></textarea></label>
        <label class="casella"><input type="checkbox" id="df-attiva" checked /> attiva (inclusa nella sorveglianza)</label>
    </div>
    <p class="sottotesto" id="df-msg"></p>
    <div style="display:flex;gap:0.5rem;justify-content:flex-end">
        <button class="pulsante pulsante-tenue" type="button" data-chiudi>Annulla</button>
        <button class="pulsante" type="button" id="df-salva">Salva</button>
    </div>
</dialog>

@* Estrazione con l'AI: famiglie da estrarre (18/10/2026) *@
<dialog class="lim" id="dlg-estrai" style="max-width:36rem">
    <h3 style="margin-top:0">Estrai con AI</h3>
    <p class="sottotesto" id="de-fonte"></p>
    <p style="margin:0.3rem 0">Quali famiglie estrarre da questa fonte? L'AI assegna a ogni scheda la sua famiglia leggendo la categoria della norma (es. nel Reg. 2073 «molluschi bivalvi vivi» → Molluschi, «alimenti pronti» → Alimenti).</p>
    <div id="de-famiglie" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(14rem,1fr));gap:0.2rem 0.8rem"></div>
    <div style="display:flex;gap:0.5rem;margin-top:0.5rem;flex-wrap:wrap">
        <button class="pulsante pulsante-tenue" type="button" id="de-tutte">tutte</button>
        <button class="pulsante pulsante-tenue" type="button" id="de-solo">solo la famiglia della fonte</button>
    </div>
    <p class="sottotesto">Per i testi molto lunghi (es. Reg. 853/2004) conviene scegliere solo le famiglie che servono: l'estrazione è più rapida e precisa.</p>
    <p class="sottotesto" id="de-msg"></p>
    <div style="display:flex;gap:0.5rem;justify-content:flex-end">
        <button class="pulsante pulsante-tenue" type="button" data-chiudi>Annulla</button>
        <button class="pulsante" type="button" id="de-avvia">Avvia l'estrazione</button>
    </div>
</dialog>

@* Caricamento file *@
<dialog class="lim" id="dlg-carica" style="max-width:34rem">
    <h3 style="margin-top:0">Carica il testo della fonte</h3>
    <p class="sottotesto" id="dc-fonte"></p>
    <div class="lim-largo">
        <label>File (PDF con testo, pagina HTML salvata dal browser, oppure .txt) <input type="file" id="dc-file" accept=".pdf,.html,.htm,.txt" /></label>
        <label>Data di aggiornamento dichiarata dalla fonte («vigente al», «consolidato al») <input type="date" id="dc-data" /></label>
    </div>
    <p class="sottotesto" id="dc-msg"></p>
    <div style="display:flex;gap:0.5rem;justify-content:flex-end">
        <button class="pulsante pulsante-tenue" type="button" data-chiudi>Annulla</button>
        <button class="pulsante" type="button" id="dc-invia">Carica</button>
    </div>
</dialog>

<div id="dati-pagina" data-valida="@(puoValidare ? "1" : "0")" data-utente="@ViewData["IdUtente"]" hidden></div>

@section Script {
    <script type="module" src="~/js/moduli/limiti-normativi.js" asp-append-version="true"></script>
}
