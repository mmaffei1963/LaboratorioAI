@inject LaboratorioAI.Core.Servizi.IContestoUtente Utente
@{
    ViewData["Titolo"] = "Ricette nutrizionali";
    var nomeRedattore = Utente.NomeCompleto == "Utente di sviluppo" ? "" : Utente.NomeCompleto;
}

<div class="barra-strumenti">
    <div>
        <h1>Ricette nutrizionali</h1>
        <p class="sottotitolo">
            Calcolo della dichiarazione nutrizionale dalla ricetta (Reg. UE 1169/2011).
            Ingredienti dal catalogo materie prime.
        </p>
    </div>
    <div class="azioni">
        <button class="pulsante" id="btn-nuova">Nuova ricetta</button>
    </div>
</div>

<section class="riquadro">
    <div class="griglia-filtri">
        <label>Cerca ricetta<input type="search" id="f-q" placeholder="denominazione o committente" /></label>
    </div>
    <div class="tabella-scorrevole">
        <table class="tabella" id="tabella-elenco">
            <thead>
                <tr><th>Denominazione</th><th>Committente</th><th class="numerico">Ingredienti</th><th>Ultima modifica</th></tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

<section class="riquadro nascosto" id="pannello-form">
    <div class="barra-risultati">
        <h2 id="form-titolo">Nuova ricetta</h2>
    </div>

    <input type="hidden" id="r-id" />
    <div class="griglia-filtri">
        <label>Denominazione<input type="text" id="r-denominazione" /></label>
        <label>Committente<input type="text" id="r-committente" list="lista-clienti" placeholder="anagrafica ArcLab" />
            <datalist id="lista-clienti"></datalist>
        </label>
        <label>Lotto<input type="text" id="r-lotto" /></label>
        <label>Unità di consumo (g)<input type="number" step="0.1" id="r-unita" value="100" /></label>
        <label>Unità di consumo (pezzi)<input type="number" step="1" id="r-pezzi" /></label>
        <label>Calo peso (%)<input type="number" step="0.1" id="r-calo" placeholder="opzionale" /></label>
        <label>Peso cotto (kg)<input type="number" step="0.001" id="r-peso-cotto" placeholder="in alternativa al %" /></label>
        <label>Redatto da<input type="text" id="r-redatto" value="@nomeRedattore" placeholder="nome sul rapporto" /></label>
        <label>Zuccheri aggiunti (g/100g)<input type="number" step="0.1" id="r-zucc-agg" placeholder="per Nutrition Facts USA" /></label>
    </div>

    <h3>Ingredienti</h3>
    <div class="azioni-filtri">
        <input type="search" id="i-cerca" placeholder="cerca materia prima nel catalogo…" style="flex:1" />
    </div>
    <div id="i-risultati" class="tabella-scorrevole nascosto" style="max-height:14rem">
        <table class="tabella"><tbody id="i-risultati-corpo"></tbody></table>
    </div>
    <div class="tabella-scorrevole">
        <table class="tabella" id="tabella-ingredienti">
            <thead>
                <tr><th>Materia prima</th><th class="numerico">Quantità (kg)</th><th></th></tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <h3>Dichiarazione nutrizionale</h3>
    <div id="risultati-avviso" class="avviso nascosto"></div>
    <div class="tabella-scorrevole">
        <table class="tabella" id="tabella-risultati">
            <thead>
                <tr>
                    <th></th>
                    <th class="numerico">per 100 g</th>
                    <th class="numerico">per porzione</th>
                    <th class="numerico">% RI (100 g)</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <p class="sottotesto" id="massa-info"></p>

    <div id="pannello-usa" class="riquadro nascosto" style="margin-top:0.6rem">
        <div class="barra-risultati">
            <h3 style="margin:0">Nutrition Facts (USA) — anteprima</h3>
            <span id="usa-porzione" class="sottotesto"></span>
        </div>
        <div class="azioni-filtri">
            <button type="button" class="pulsante pulsante-tenue" id="btn-usa-verifica">Verifica congruità (AI)</button>
            <div style="flex:1"></div>
            <button type="button" class="pulsante pulsante-tenue" id="btn-usa-pdf">Scarica pannello PDF</button>
            <button type="button" class="pulsante pulsante-tenue" id="btn-usa-word">Scarica pannello Word</button>
        </div>
        <div id="usa-avviso" class="avviso nascosto"></div>
        <div id="usa-verifica" class="nascosto" style="margin-top:0.4rem">
            <span id="usa-verifica-esito" class="sottotesto"></span>
            <div id="usa-verifica-testo" style="white-space:pre-wrap"></div>
        </div>
        <div class="tabella-scorrevole">
            <table class="tabella" id="tabella-usa">
                <thead><tr><th>Nutrient</th><th class="numerico">Amount per serving</th><th class="numerico">% Daily Value</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <div id="pannello-ca" class="riquadro nascosto" style="margin-top:0.6rem">
        <div class="barra-risultati">
            <h3 style="margin:0">Valeur nutritive / Nutrition Facts (Canada) — anteprima</h3>
            <span id="ca-porzione" class="sottotesto"></span>
        </div>
        <div class="azioni-filtri">
            <button type="button" class="pulsante pulsante-tenue" id="btn-ca-verifica">Verifica congruità (AI)</button>
            <div style="flex:1"></div>
            <button type="button" class="pulsante pulsante-tenue" id="btn-ca-pdf">Scarica pannello PDF</button>
            <button type="button" class="pulsante pulsante-tenue" id="btn-ca-word">Scarica pannello Word</button>
        </div>
        <div id="ca-avviso" class="avviso nascosto"></div>
        <div id="ca-verifica" class="nascosto" style="margin-top:0.4rem">
            <span id="ca-verifica-esito" class="sottotesto"></span>
            <div id="ca-verifica-testo" style="white-space:pre-wrap"></div>
        </div>
        <div class="tabella-scorrevole">
            <table class="tabella" id="tabella-ca">
                <thead><tr><th>Nutrient / Élément nutritif</th><th class="numerico">Amount / Teneur</th><th class="numerico">% DV / VQ</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <div id="pannello-verifica" class="riquadro nascosto" style="margin-top:0.6rem">
        <div class="barra-risultati">
            <h3 style="margin:0">Verifica di plausibilità (AI)</h3>
            <span id="verifica-esito" class="sottotesto"></span>
        </div>
        <div id="verifica-testo" style="white-space:pre-wrap"></div>
    </div>

    <div class="azioni-filtri">
        <div style="flex:1"></div>
        <button class="pulsante pulsante-tenue" id="btn-annulla">Annulla</button>
        <button class="pulsante pulsante-secondario" id="btn-verifica">Verifica AI</button>
        <button class="pulsante pulsante-secondario" id="btn-usa">Nutrition Facts (USA)</button>
        <button class="pulsante pulsante-secondario" id="btn-ca">Valeur nutritive (Canada)</button>
        <button class="pulsante pulsante-secondario" id="btn-pdf">Rapporto PDF</button>
        <button class="pulsante pulsante-secondario" id="btn-word">Rapporto Word</button>
        <button class="pulsante" id="btn-salva">Salva ricetta</button>
    </div>
</section>

@section Script {
    <script type="module" src="~/js/moduli/ricette.js" asp-append-version="true"></script>
}
