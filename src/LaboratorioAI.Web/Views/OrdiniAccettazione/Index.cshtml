@{
    ViewData["Titolo"] = "Ordini di Accettazione";
}

<div class="barra-strumenti">
    <div>
        <h1>Ordini di Accettazione</h1>
        <p class="sottotitolo">Genera l'Ordine di Accettazione dei lotti già ricevuti in ArcLab (sola lettura: nulla viene scritto sul gestionale). Il documento riporta il riepilogo dei campioni con i prezzi di commessa, il riquadro delle condizioni (Allegato A Rev. 19) e l'allegato tecnico per campione. Il PDF va poi pubblicato sul portale Palomar.</p>
    </div>
</div>

<section class="riquadro">
    <div class="griglia-filtri">
        <label>Dal (data ricezione)
            <input type="date" id="f-dal" />
        </label>
        <label>Al (data ricezione)
            <input type="date" id="f-al" />
        </label>
        <div style="display:flex;align-items:flex-end;gap:0.5rem">
            <button class="pulsante" id="btn-carica">Carica lotti</button>
            <button class="pulsante secondario" id="btn-schedulati" title="Registra come emessi tutti i lotti del periodo non ancora emessi, pronti (guardia anti-doppione)">Genera schedulati (periodo)</button>
        </div>
        <label class="casella" style="grid-column:1/-1"><input type="checkbox" id="filtro-non-pronti" /> mostra anche i lotti senza parametri caricati (non generabili)</label>
    </div>
    <p class="sottotesto" id="msg"></p>
</section>

<section class="riquadro">
    <div class="tabella-scorrevole" style="max-height:32rem">
        <table class="tabella" id="tabella-lotti">
            <thead>
                <tr>
                    <th>Cod. lotto</th>
                    <th>Data ric.</th>
                    <th>Cliente</th>
                    <th class="numerico">Campioni</th>
                    <th>Stato</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

@section Script {
    <script type="module" src="~/js/moduli/ordini-accettazione.js" asp-append-version="true"></script>
}
