@inject IContestoUtente Utente
@{
    ViewData["Titolo"] = "Home";
    var cartelle = LaboratorioAI.Web.Navigazione.MenuApplicazione.Visibili(Utente.HaPermesso).ToList();
    // Preferiti nell'ordine scelto, solo tra le funzioni che l'utente vede ancora.
    var voci = cartelle.SelectMany(c => c.Voci.Select(v => (Cartella: c, Voce: v))).ToList();
    var urlPreferiti = ViewData["Preferiti"] as List<string> ?? new List<string>();
    var preferiti = urlPreferiti
        .Select(u => voci.FirstOrDefault(x => string.Equals(x.Voce.Url, u, StringComparison.OrdinalIgnoreCase)))
        .Where(x => x.Voce is not null).ToList();
    var insiemePreferiti = preferiti.Select(x => x.Voce.Url).ToHashSet(StringComparer.OrdinalIgnoreCase);
    const string Stella = "M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z";
}

@* Cartelle generate da Navigazione/MenuApplicazione.cs: stessa fonte del menu in testata, quindi ogni pagina
   aggiunta al menu compare anche qui. Una cartella si vede se l'utente ha almeno una funzione dentro.
   Clic sulla cartella: si apre la finestra con le sue funzioni; ogni funzione è un collegamento normale
   (si apre come pagina, anche in una nuova scheda).
   Contatori («cose da fare»): la pagina si apre subito, poi home.js chiede i numeri a api/home/contatori
   (Navigazione/ContatoriHome.cs) e li scrive nei segnaposto data-conta-voce / data-conta-cartella.
   Preferiti: stellina accanto a ogni funzione nella finestra (POST api/home/preferiti, tabella app.PreferitiUtenti);
   la riga «Preferiti» è scritta qui e ricostruita da home.js quando si mette o toglie una stella.
   Ricerca: casella in testata, filtra nel browser le funzioni visibili (nome, descrizione, cartella), senza chiamate
   al server; mentre si scrive i risultati prendono il posto delle cartelle. Tasto «/» per andare alla casella. *@

<div class="home-testata">
    <h1>Dove vuoi andare?</h1>
    <p class="sottotitolo">Benvenuto, @ViewData["NomeUtente"]. Dentro ogni cartella trovi solo le funzioni a cui hai accesso.</p>
    @if (cartelle.Count > 0)
    {
        <div class="home-cerca">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 0 14a7 7 0 1 0 0-14M20 20l-4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            <input type="search" id="home-cerca" placeholder="Cerca una funzione (es. tarature, preventivi, sonde)…" autocomplete="off"
                   aria-label="Cerca una funzione" aria-controls="home-risultati" />
        </div>
    }
</div>

<section class="home-risultati" id="home-risultati" aria-live="polite" hidden>
    <div class="home-voci" id="home-risultati-elenco"></div>
    <p class="home-preferiti-vuoto" id="home-risultati-vuoto" hidden>Nessuna funzione trovata. Prova con un'altra parola.</p>
</section>

@if (cartelle.Count > 0)
{
    <section class="home-preferiti" aria-labelledby="titolo-preferiti">
        <h2 id="titolo-preferiti">Preferiti</h2>
        <div class="home-preferiti-elenco" id="preferiti-elenco">
            @foreach (var (c, v) in preferiti)
            {
                <a class="home-preferito" href="@v.Url" data-url="@v.Url">
                    <span class="home-preferito-icona" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24"><path d="@c.Icona" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                    <span class="home-preferito-testo"><strong>@v.Titolo</strong><small>@c.TitoloHome</small></span>
                    <em class="home-conta-voce" data-conta-voce="@v.Url" hidden></em>
                </a>
            }
        </div>
        <p class="home-preferiti-vuoto" id="preferiti-vuoto" hidden="@(preferiti.Count > 0)">Apri una cartella e clicca la stellina ☆ accanto a una funzione: la ritrovi qui, a un clic.</p>
    </section>
}

@if (cartelle.Count == 0)
{
    <section class="riquadro"><p>Nessuna funzione disponibile per il tuo utente. Chiedi l'accesso all'amministratore.</p></section>
}

<div class="home-cartelle" id="home-cartelle">
    @foreach (var c in cartelle)
    {
        <button type="button" class="home-cartella" data-apri="cartella-@c.Codice" data-cartella="@c.Codice" aria-haspopup="dialog">
            <span class="home-cartella-riga">
                <span class="home-icona" aria-hidden="true">
                    <svg width="26" height="26" viewBox="0 0 24 24"><path d="@c.Icona" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <span class="home-conta" data-conta-cartella="@c.Codice" hidden></span>
            </span>
            <span class="home-cartella-nome">@c.TitoloHome</span>
            <span class="home-cartella-sotto">@c.Descrizione · @c.Voci.Count @(c.Voci.Count == 1 ? "funzione" : "funzioni")</span>
        </button>
    }
</div>

@foreach (var c in cartelle)
{
    <dialog class="home-finestra" id="cartella-@c.Codice" data-cartella="@c.Codice" aria-labelledby="titolo-@c.Codice">
        <header>
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="@c.Icona" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <h2 id="titolo-@c.Codice">@c.TitoloHome</h2>
            <form method="dialog"><button class="home-chiudi" aria-label="Chiudi">✕</button></form>
        </header>
        <div class="home-voci">
            @foreach (var v in c.Voci)
            {
                var stella = insiemePreferiti.Contains(v.Url);
                <div class="home-voce-blocco">
                    <a class="home-voce" href="@v.Url" data-titolo="@v.Titolo" data-cartella-nome="@c.TitoloHome" data-icona="@c.Icona">
                        <strong>@v.Titolo</strong>
                        <span>@v.Descrizione</span>
                        <em class="home-conta-voce" data-conta-voce="@v.Url" hidden></em>
                    </a>
                    <button type="button" class="home-stella" data-stella="@v.Url" aria-pressed="@(stella ? "true" : "false")"
                            title="@(stella ? "Togli dai preferiti" : "Aggiungi ai preferiti")" aria-label="Preferito: @v.Titolo">
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="@Stella" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    </button>
                </div>
            }
        </div>
    </dialog>
}

@section Script {
    <script type="module" src="~/js/moduli/home.js" asp-append-version="true"></script>
}
