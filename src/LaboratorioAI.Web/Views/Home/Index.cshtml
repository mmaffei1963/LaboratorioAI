@inject IContestoUtente Utente
@{
    ViewData["Titolo"] = "Home";

    bool gLab = Utente.HaPermesso(Permessi.ValidazioneVisualizza) || Utente.HaPermesso(Permessi.ConsultazioneCampioni)
        || Utente.HaPermesso(Permessi.MetodiConsulta) || Utente.HaPermesso(Permessi.CommesseConsulta)
        || Utente.HaPermesso(Permessi.LaboratoriEsterniConsulta) || Utente.HaPermesso(Permessi.PrefatturatoTamponi)
        || Utente.HaPermesso(Permessi.PrefatturatoNonFatturare) || Utente.HaPermesso(Permessi.AccettazioneEsegui)
        || Utente.HaPermesso(Permessi.OrdiniAccettazioneGestione)
        || Utente.HaPermesso(Permessi.SoloEsterniVisualizza) || Utente.HaPermesso(Permessi.ControlliProponi)
        || Utente.HaPermesso(Permessi.RicercaErroriVisualizza) || Utente.HaPermesso(Permessi.CertificatiEsterniGestione)
        || Utente.HaPermesso(Permessi.PreventiviGestione);
    bool gMan = Utente.HaPermesso(Permessi.DvrGenera) || Utente.HaPermesso(Permessi.PiscineGenera);
    bool gNut = Utente.HaPermesso(Permessi.NutrizionaleMateriePrime) || Utente.HaPermesso(Permessi.NutrizionaleRicette);
    bool gStr = Utente.HaPermesso(Permessi.TaraturaEsegui) || Utente.HaPermesso(Permessi.IncubatoriEsegui)
        || Utente.HaPermesso(Permessi.MappaturaEsegui) || Utente.HaPermesso(Permessi.BilanceEsegui)
        || Utente.HaPermesso(Permessi.TempLogEsegui) || Utente.HaPermesso(Permessi.ScadenziarioVisualizza);
}

<div class="riquadro">
    <h1>Laboratorio AI</h1>
    <p class="sottotitolo">Benvenuto, @ViewData["NomeUtente"].</p>
</div>

@if (gLab)
{
    <h2 class="titolo-sezione">Laboratorio</h2>
    <div class="griglia-schede">
        @if (Utente.HaPermesso(Permessi.ValidazioneVisualizza))
        {
            <a class="scheda scheda-collegamento" href="/Validazione">
                <h2>Da Validare</h2>
                <p>Campioni pronti per la validazione e analisi AI, singola o massiva.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.ConsultazioneCampioni))
        {
            <a class="scheda scheda-collegamento" href="/Consultazione">
                <h2>Consultazione</h2>
                <p>Ricerca campioni nell'archivio storico con filtri combinabili.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.ConsultazioneCertificati))
        {
            <a class="scheda scheda-collegamento" href="/Consultazione/Certificati">
                <h2>Certificati emessi</h2>
                <p>Ricerca dei rapporti di prova e analisi a posteriori.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.MetodiConsulta))
        {
            <a class="scheda scheda-collegamento" href="/Metodi">
                <h2>Metodi e Controlli</h2>
                <p>Ricerca bidirezionale, accreditamenti, subappalti e prezzi.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.CommesseConsulta))
        {
            <a class="scheda scheda-collegamento" href="/Commesse">
                <h2>Commesse</h2>
                <p>Commesse in vigore, campioni collegati e prestazioni erogate.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.LaboratoriEsterniConsulta))
        {
            <a class="scheda scheda-collegamento" href="/LaboratoriEsterni">
                <h2>Laboratori Esterni</h2>
                <p>Analisi affidate all'esterno, riepiloghi ed esportazione.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.PrefatturatoTamponi))
        {
            <a class="scheda scheda-collegamento" href="/TamponiContratto">
                <h2>Tamponi in contratto</h2>
                <p>Prefatturato dei tamponi previsti dai contratti.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.PrefatturatoNonFatturare))
        {
            <a class="scheda scheda-collegamento" href="/NonFatturare">
                <h2>Non fatturare</h2>
                <p>Prestazioni escluse dalla fatturazione.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.AccettazioneEsegui))
        {
            <a class="scheda scheda-collegamento" href="/Accettazione">
                <h2>Accettazione campioni</h2>
                <p>Accettazione fuori sede e generazione del tracciato per Palomar.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.OrdiniAccettazioneGestione))
        {
            <a class="scheda scheda-collegamento" href="/OrdiniAccettazione">
                <h2>Ordini di Accettazione</h2>
                <p>Genera l'Ordine di Accettazione dai lotti ricevuti, con riepilogo e allegato tecnico.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.SoloEsterniVisualizza))
        {
            <a class="scheda scheda-collegamento" href="/SoloEsterni">
                <h2>Certificati esterni non ricertificati</h2>
                <p>Confronto tra certificati esterni e interni per la fatturazione.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.CertificatiEsterniGestione))
        {
            <a class="scheda scheda-collegamento" href="/CertificatiEsterni">
                <h2>Certificati esterni · rinomina</h2>
                <p>Triage e rinomina dei certificati dei laboratori esterni per il portale.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.ControlliProponi))
        {
            <a class="scheda scheda-collegamento" href="/Controlli">
                <h2>Proposta controlli</h2>
                <p>Proposta e approvazione di nuovi controlli con import supervisionato.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.PreventiviGestione))
        {
            <a class="scheda scheda-collegamento" href="/Preventivi">
                <h2>Preventivi</h2>
                <p>Componi le offerte dai controlli e metodi in archivio, su carta intestata.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.RicercaErroriVisualizza))
        {
            <a class="scheda scheda-collegamento" href="/RicercaErrori">
                <h2>Ricerca errori</h2>
                <p>Verifiche diagnostiche sull'archivio (sola lettura).</p>
            </a>
        }
    </div>
}

@if (gMan)
{
    <h2 class="titolo-sezione">Documenti e DVR</h2>
    <div class="griglia-schede">
        @if (Utente.HaPermesso(Permessi.DvrGenera))
        {
            <a class="scheda scheda-collegamento" href="/Dvr">
                <h2>DVR Legionella</h2>
                <p>Generazione dei documenti di valutazione del rischio, singola o massiva.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.PiscineGenera))
        {
            <a class="scheda scheda-collegamento" href="/Piscine">
                <h2>DVR Piscine</h2>
                <p>Valutazione del rischio per le piscine e registro dei documenti.</p>
            </a>
        }
    </div>
}

@if (gNut)
{
    <h2 class="titolo-sezione">Nutrizionale</h2>
    <div class="griglia-schede">
        @if (Utente.HaPermesso(Permessi.NutrizionaleMateriePrime))
        {
            <a class="scheda scheda-collegamento" href="/MateriePrime">
                <h2>Materie prime</h2>
                <p>Catalogo delle materie prime e dei valori nutrizionali.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.NutrizionaleRicette))
        {
            <a class="scheda scheda-collegamento" href="/Ricette">
                <h2>Ricette nutrizionali</h2>
                <p>Composizione delle ricette e rapporti nutrizionali (USA/Canada).</p>
            </a>
        }
    </div>
}

@if (gStr)
{
    <h2 class="titolo-sezione">Strumenti e tarature</h2>
    <div class="griglia-schede">
        @if (Utente.HaPermesso(Permessi.TaraturaEsegui))
        {
            <a class="scheda scheda-collegamento" href="/Taratura">
                <h2>Taratura termometri</h2>
                <p>Taratura, validazione e registro dei termometri.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.IncubatoriEsegui))
        {
            <a class="scheda scheda-collegamento" href="/Incubatori">
                <h2>Taratura incubatori</h2>
                <p>Taratura e validazione degli incubatori.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.MappaturaEsegui))
        {
            <a class="scheda scheda-collegamento" href="/Mappatura">
                <h2>Mappatura incubatori</h2>
                <p>Mappatura termica e validazione.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.BilanceEsegui))
        {
            <a class="scheda scheda-collegamento" href="/Bilance">
                <h2>Taratura bilance</h2>
                <p>Taratura e validazione delle bilance.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.TempLogEsegui))
        {
            <a class="scheda scheda-collegamento" href="/TempLog">
                <h2>Monitoraggio Econorma</h2>
                <p>Andamento temperature da file o database, con limiti.</p>
            </a>
        }
        @if (Utente.HaPermesso(Permessi.ScadenziarioVisualizza))
        {
            <a class="scheda scheda-collegamento" href="/Scadenziario">
                <h2>Scadenziario tarature</h2>
                <p>Scadenze delle tarature e pianificazione.</p>
            </a>
        }
    </div>
}
