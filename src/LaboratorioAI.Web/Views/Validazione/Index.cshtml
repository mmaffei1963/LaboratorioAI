@inject IContestoUtente Utente
@{
    ViewData["Titolo"] = "Da Validare";
}

<div class="barra-strumenti">
    <div>
        <h1>Campioni da validare</h1>
        <p class="sottotitolo" id="riepilogo">Caricamento…</p>
    </div>
    <div class="azioni">
        @if (Utente.HaPermesso(Permessi.ValidazioneAnalizzaLotto))
        {
            <button class="pulsante pulsante-secondario" id="btn-massivo">Analisi massiva</button>
        }
        <button class="pulsante" id="btn-aggiorna">Aggiorna</button>
    </div>
</div>

<div class="disposizione-doppia">

    <section class="riquadro pannello-elenco">
        <input type="search" id="filtro-elenco" class="campo-ricerca"
               placeholder="Filtra per cliente, campione o matrice…" autocomplete="off" />
        <div id="elenco-campioni" class="elenco"></div>
    </section>

    <section id="pannello-dettaglio" class="riquadro nascosto">
        <div id="intestazione-campione"></div>

        <table class="tabella" id="tabella-prove">
            <thead>
                <tr>
                    <th>Parametro</th>
                    <th>Valore</th>
                    <th>U.M.</th>
                    <th>Riferimento</th>
                    <th>Metodo</th>
                    <th>Esito</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <div class="azioni-dettaglio">
            <button class="pulsante" id="btn-analizza">Analizza con AI</button>
            <button class="pulsante pulsante-secondario nascosto" id="btn-archivio">
                Usa analisi archiviata
            </button>
            <button class="pulsante pulsante-tenue nascosto" id="btn-rianalizza">Riesegui</button>
        </div>

        <div id="esito-analisi" class="esito nascosto"></div>
    </section>

    <section id="segnaposto-dettaglio" class="riquadro segnaposto">
        <p>Seleziona un campione dall'elenco per vederne il dettaglio.</p>
    </section>

</div>

<div id="finestra-massiva" class="finestra nascosto">
    <div class="finestra-contenuto">
        <header>
            <h2>Analisi massiva</h2>
            <button class="chiudi" id="chiudi-massiva">&times;</button>
        </header>
        <div id="corpo-massiva"></div>
    </div>
</div>

@section Script {
    <script type="module" src="~/js/moduli/validazione.js" asp-append-version="true"></script>
}
