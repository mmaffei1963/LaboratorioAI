@{
    ViewData["Titolo"] = "Ricerca errori";
    var oggi = DateTime.Today.Year;
}

<div class="barra-strumenti">
    <div>
        <h1>Ricerca errori</h1>
        <p class="sottotitolo">Verifiche diagnostiche in sola lettura su ArcLab: nessuna modifica ai dati. Ogni sezione produce un elenco da correggere a mano nel gestionale.</p>
    </div>
</div>

<!-- Cruscotto controlli -->
<section class="riquadro" id="cruscotto">
    <div class="barra-risultati"><h2>Cruscotto controlli</h2><span id="k-info" class="sottotesto"></span></div>
    <p class="sottotesto">Spunta i controlli da eseguire e premi «Esegui selezionati» per il colpo d'occhio; «Esporta tutto» genera un unico Excel con un foglio per controllo. Il filtro anni e la soglia valgono per i controlli che li usano.</p>
    <div class="griglia-filtri">
        <label>Anno da<input type="number" id="k-da" value="@(oggi - 1)" /></label>
        <label>Anno a<input type="number" id="k-a" value="@oggi" /></label>
        <label>Soglia margine %<input type="number" id="k-soglia" value="15" min="0" max="100" step="0.5" /></label>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:0.4rem 1.4rem;margin-top:0.6rem">
        <label><input type="checkbox" class="k-chk" data-chiave="duplicati" checked /> 1 · Doppioni rapporti</label>
        <label><input type="checkbox" class="k-chk" data-chiave="arrotondamento" checked /> 2 · Metodi senza cifre/decimali</label>
        <label><input type="checkbox" class="k-chk" data-chiave="margine" checked /> 3 · Margine sotto soglia</label>
        <label><input type="checkbox" class="k-chk" data-chiave="doppi" checked /> 4 · Metodi doppi</label>
        <label><input type="checkbox" class="k-chk" data-chiave="ricevitore" checked /> 5 · Lotti senza ricevitore</label>
        <label><input type="checkbox" class="k-chk" data-chiave="vettore" checked /> 6 · Lotti senza vettore</label>
        <label><input type="checkbox" class="k-chk" data-chiave="coerenza" checked /> 7 · Coerenza prelevatore/vettore</label>
        <label><input type="checkbox" class="k-chk" data-chiave="stampa" checked /> 8 · Campioni non pronti stampa</label>
        <label><input type="checkbox" class="k-chk" data-chiave="prezzimarea" checked /> 10 · Prezzi commesse diversi da Marea</label>
        <label><input type="checkbox" class="k-chk" data-chiave="commessemarea" checked /> 11 · Altre differenze commesse ArcLab/Marea</label>
        <label><input type="checkbox" class="k-chk" data-chiave="senzacontratto" checked /> 12 · Commesse senza numero di contratto</label>
    </div>
    <div class="azioni-filtri" style="margin-top:0.8rem">
        <div style="flex:1"></div>
        <button type="button" class="pulsante pulsante-tenue" id="k-esporta">Esporta tutto (Excel)</button>
        <button type="button" class="pulsante" id="k-esegui">Esegui selezionati</button>
    </div>
    <div class="tabella-scorrevole" style="margin-top:0.6rem">
        <table class="tabella" id="k-tab">
            <thead><tr><th>Controllo</th><th class="numerico">Anomalie</th><th>Stato</th><th></th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
</section>

<!-- 1. Doppioni sui rapporti di prova -->
<section class="riquadro">
    <details open>
        <summary style="cursor:pointer;font-weight:600">1 · Doppioni di parametro sui rapporti di prova</summary>
        <p class="sottotesto">Stesso IdParametro ripetuto sullo stesso campione con la stessa denominazione riga. Esclusi i microbiologici e la coppia legittima del valore energetico (kJ/kcal).</p>
        <div class="griglia-filtri">
            <label>Anno da<input type="number" id="d-da" value="@(oggi - 1)" /></label>
            <label>Anno a<input type="number" id="d-a" value="@oggi" /></label>
        </div>
        <div class="azioni-filtri" style="margin-top:0.6rem">
            <span id="d-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="d-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="d-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:26rem;margin-top:0.6rem">
            <table class="tabella" id="d-tab">
                <thead><tr>
                    <th>Id cert.</th><th>N° cert.</th><th>Data</th><th>Id camp.</th><th>Cod camp.</th>
                    <th>Id par.</th><th>Parametro</th><th>Id riga met.</th><th>Denominazione riga</th>
                    <th>Id prova</th><th class="numerico">Valore</th><th class="numerico">Occ.</th>
                </tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

<!-- 2. Metodi senza arrotondamento -->
<section class="riquadro">
    <details>
        <summary style="cursor:pointer;font-weight:600">2 · Metodi attivi senza cifre significative / decimali max</summary>
        <p class="sottotesto">Metodi attivi (ProceduraMetodo.Attivo = Sì) con Cifre_significative e/o Decimali_Max non compilati.</p>
        <div class="azioni-filtri" style="margin-top:0.4rem">
            <span id="a-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="a-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="a-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:26rem;margin-top:0.6rem">
            <table class="tabella" id="a-tab">
                <thead><tr>
                    <th>Id metodo</th><th>Id par.</th><th>Parametro</th><th>Id tipo met.</th><th>Rif. metodo</th>
                    <th>Dettagli metodo</th><th>Rif. biblio</th><th>Id unità</th>
                    <th>Cifre sign.</th><th>Decimali max</th>
                </tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

<!-- 3. Margine metodo -->
<section class="riquadro">
    <details>
        <summary style="cursor:pointer;font-weight:600">3 · Metodi con margine sotto soglia</summary>
        <p class="sottotesto">Metodi attivi in cui (CostoMetodoEuro − CostoAnoi)/CostoMetodoEuro è sotto la soglia impostata. Include i casi con CostoAnoi superiore al prezzo (margine negativo).</p>
        <div class="griglia-filtri">
            <label>Soglia margine %<input type="number" id="m-soglia" value="15" min="0" max="100" step="0.5" /></label>
        </div>
        <div class="azioni-filtri" style="margin-top:0.6rem">
            <span id="m-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="m-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="m-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:26rem;margin-top:0.6rem">
            <table class="tabella" id="m-tab">
                <thead><tr>
                    <th>Id metodo</th><th>Id par.</th><th>Parametro</th><th>Id tipo met.</th><th>Rif. metodo</th>
                    <th>Dettagli metodo</th><th>Rif. biblio</th><th>Id unità</th>
                    <th class="numerico">Costo a noi €</th><th class="numerico">Costo metodo €</th><th class="numerico">Margine %</th>
                </tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

<!-- 4. Metodi doppi -->
<section class="riquadro">
    <details>
        <summary style="cursor:pointer;font-weight:600">4 · Metodi potenzialmente doppi</summary>
        <p class="sottotesto">Metodi attivi con stesso IdParametro, stessa DettagliMetodo e stessa RifMetodo (al netto di spazi e maiuscole/minuscole).</p>
        <div class="azioni-filtri" style="margin-top:0.4rem">
            <span id="p-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="p-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="p-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:26rem;margin-top:0.6rem">
            <table class="tabella" id="p-tab">
                <thead><tr>
                    <th>Id metodo</th><th>Id par.</th><th>Parametro</th><th>Id tipo met.</th><th>Rif. metodo</th>
                    <th>Dettagli metodo</th><th>Rif. biblio</th><th>Id unità</th><th class="numerico">N° nel gruppo</th>
                </tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

<!-- 5. Lotti senza ricevitore -->
<section class="riquadro">
    <details>
        <summary style="cursor:pointer;font-weight:600">5 · Lotti senza ricevitore</summary>
        <p class="sottotesto">Lotti (per anno di ricezione) con IdRicevitore non valorizzato.</p>
        <div class="griglia-filtri">
            <label>Anno da<input type="number" id="r-da" value="@(oggi - 1)" /></label>
            <label>Anno a<input type="number" id="r-a" value="@oggi" /></label>
        </div>
        <div class="azioni-filtri" style="margin-top:0.6rem">
            <span id="r-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="r-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="r-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:26rem;margin-top:0.6rem">
            <table class="tabella" id="r-tab">
                <thead><tr><th>Id lotto</th><th>Cod lotto</th><th>Data ric.</th><th>Id commessa</th><th>Cliente</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

<!-- 6. Lotti senza vettore -->
<section class="riquadro">
    <details>
        <summary style="cursor:pointer;font-weight:600">6 · Lotti senza vettore</summary>
        <p class="sottotesto">Lotti (per anno di ricezione) con IdVettore non valorizzato.</p>
        <div class="griglia-filtri">
            <label>Anno da<input type="number" id="v-da" value="@(oggi - 1)" /></label>
            <label>Anno a<input type="number" id="v-a" value="@oggi" /></label>
        </div>
        <div class="azioni-filtri" style="margin-top:0.6rem">
            <span id="v-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="v-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="v-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:26rem;margin-top:0.6rem">
            <table class="tabella" id="v-tab">
                <thead><tr><th>Id lotto</th><th>Cod lotto</th><th>Data ric.</th><th>Id commessa</th><th>Cliente</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

<!-- 7. Coerenza prelevatore / vettore / verbale -->
<section class="riquadro">
    <details>
        <summary style="cursor:pointer;font-weight:600">7 · Coerenza prelevatore interno / vettore / verbale</summary>
        <p class="sottotesto">Incoerenza di categoria fra prelevatore e vettore (decisa dai nomi): se il prelevatore è interno anche il vettore deve esserlo, se è cliente/terza parte anche il vettore deve esserlo. Inoltre, se il prelevatore è cliente/terza parte, il verbale di prelievo (Lotto.BuonoPrelievo) non deve esserci.</p>
        <div class="griglia-filtri">
            <label>Anno da<input type="number" id="c-da" value="@(oggi - 1)" /></label>
            <label>Anno a<input type="number" id="c-a" value="@oggi" /></label>
        </div>
        <div class="azioni-filtri" style="margin-top:0.6rem">
            <span id="c-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="c-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="c-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:26rem;margin-top:0.6rem">
            <table class="tabella" id="c-tab">
                <thead><tr>
                    <th>Id lotto</th><th>Cod lotto</th><th>Data ric.</th><th>Id camp.</th><th>Cod camp.</th>
                    <th>Id prel.</th><th>Prelevatore</th><th>Id vett.</th><th>Vettore</th><th>Verbale</th><th>Anomalia</th>
                </tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

<!-- 8. Campioni pronti per la stampa -->
<section class="riquadro">
    <details>
        <summary style="cursor:pointer;font-weight:600">8 · Campioni «chiusi» non pronti alla stampa</summary>
        <p class="sottotesto">Campioni con AnalisiChiusa spuntato ma con almeno una condizione non rispettata: prova con VerificaValore non spuntato, DataInizioProva/DataFineProva mancanti, oppure rigametodo collegata senza Arrotonda/MaxDecimali. Ricerca per data (ricevimento lotto) oppure per singolo lotto/campione (in tal caso le date sono ignorate).</p>
        <div class="griglia-filtri">
            <label>Data da<input type="date" id="s-da" /></label>
            <label>Data a<input type="date" id="s-a" /></label>
            <label>Lotto (CodLotto)<input type="text" id="s-lotto" placeholder="es. 5298" /></label>
            <label>Campione (CodCampione)<input type="text" id="s-campione" placeholder="es. 01" /></label>
        </div>
        <div class="azioni-filtri" style="margin-top:0.6rem">
            <span id="s-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="s-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="s-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:26rem;margin-top:0.6rem">
            <table class="tabella" id="s-tab">
                <thead><tr>
                    <th>Id lotto</th><th>Cod lotto</th><th>Data ric.</th><th>Id camp.</th><th>Cod camp.</th><th>Cliente</th>
                    <th>Id prova</th><th>Id riga met.</th><th>Denominazione riga</th><th>Parametro</th>
                    <th>Verifica</th><th>Inizio</th><th>Fine</th><th>Arrot.</th><th>MaxDec.</th><th>Anomalia</th>
                </tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

<!-- 9. Denominazioni dei metodi -->
<section class="riquadro">
    <details>
        <summary style="cursor:pointer;font-weight:600">9 · Denominazioni dei metodi da controllare</summary>
        <p class="sottotesto">Metodi attivi la cui denominazione (Metodo.DettagliMetodo, quella stampata nel Rapporto di Prova e
            nell'Ordine di Accettazione) <strong>non cita il parametro</strong> oppure è <strong>usata per parametri diversi</strong>
            (es. «Manganese» sul metodo del mercurio). Il confronto ignora accenti e maiuscole e guarda anche la parte inglese:
            ci saranno falsi allarmi, che si segnano una volta come corretti e non ricompaiono finché in ArcLab non cambiano
            denominazione o parametro. Le correzioni si fanno in ArcLab. «Rapporti emessi» conta i rapporti di prova del periodo
            con prove di quel metodo: se è maggiore di zero, la denominazione sbagliata è già uscita.</p>
        <div class="griglia-filtri">
            <label>Rapporti dall'anno<input type="number" id="n-da" min="1990" max="2100" /></label>
            <label>all'anno<input type="number" id="n-a" min="1990" max="2100" /></label>
            <label class="casella" style="align-self:end"><input type="checkbox" id="n-verificate" /> mostra anche quelle segnate corrette</label>
        </div>
        <div class="azioni-filtri" style="margin-top:0.6rem">
            <span id="n-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="n-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="n-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:30rem;margin-top:0.6rem">
            <table class="tabella" id="n-tab">
                <thead><tr>
                    <th>Segnalazione</th><th>Id metodo</th><th>Parametro</th><th>Denominazione</th><th>Metodo</th>
                    <th class="numerico">Rapporti emessi</th><th>Ultimo</th><th>Verifica</th>
                </tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

<!-- 10. Prezzi commesse ArcLab ↔ Marea (28/10/2026) -->
<section class="riquadro">
    <details>
        <summary style="cursor:pointer;font-weight:600">10 · Prezzi delle commesse: ArcLab ↔ Marea</summary>
        <p class="sottotesto">Confronta il prezzo delle <strong>commesse di laboratorio attive</strong> di ArcLab (per insediamento e
            controllo) con i <strong>listini del database Marea</strong>: ogni riga di listino va alla sua commessa con il numero di
            contratto (Listini.IDContratto = commessa.NContratto) e il controllo; le righe senza contratto per cliente
            (Marea.Clienti.IDArcLab) e controllo. Fa fede ArcLab. Casi: <em>prezzo diverso</em>, <em>manca in Marea</em>, <em>solo in Marea</em> (nessuna commessa
            attiva in ArcLab per quel cliente e controllo), <em>prezzi diversi tra insediamenti</em> dello stesso cliente in ArcLab.
            Solo clienti <strong>attivi in ArcLab e con codice contabilità</strong> (anche per le righe di Marea): gli altri non vanno nel
            portale. Esclusi i clienti obsoleti in Marea e le commesse senza prezzo. «Manca in Marea» solo per le commesse con numero di
            contratto: il portale prende solo quelle (le commesse senza contratto sono nella sezione 12). Sola lettura su entrambi i database.</p>
        <div class="griglia-filtri">
            <label>Caso
                <select id="z-caso">
                    <option value="">tutti</option>
                    <option>Prezzo diverso</option>
                    <option>Manca in Marea</option>
                    <option>Solo in Marea</option>
                    <option>Prezzi diversi tra insediamenti</option>
                </select>
            </label>
            <label>Cliente o controllo<input type="text" id="z-testo" placeholder="filtra…" /></label>
        </div>
        <div class="azioni-filtri" style="margin-top:0.6rem">
            <span id="z-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="z-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="z-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:30rem;margin-top:0.6rem">
            <table class="tabella" id="z-tab">
                <thead><tr>
                    <th>Caso</th><th>Cliente</th><th>Insediamento</th><th>Controllo</th><th>Commessa</th>
                    <th class="numerico">Prezzo ArcLab</th><th class="numerico">Prezzo Marea</th><th class="numerico">Differenza</th>
                    <th>Commessa ArcLab: data / ultimo rinnovo</th><th>Ultimo campione</th><th>Ultima modifica Marea</th>
                </tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

<!-- 11. Commesse ArcLab ↔ Marea oltre ai prezzi (28/10/2026) -->
<section class="riquadro">
    <details>
        <summary style="cursor:pointer;font-weight:600">11 · Commesse: altre differenze ArcLab ↔ Marea</summary>
        <p class="sottotesto">Oltre ai prezzi (sezione 10) confronta le <strong>commesse di laboratorio attive</strong> di ArcLab con il
            database Marea. Fa fede ArcLab. Casi: <em>descrizione diversa</em> (descrizione nel listino di Marea diversa dalla descrizione
            della commessa in ArcLab, DescrIncarico; abbinamento per contratto come nella sezione 10); <em>commessa mancante in Marea</em>; <em>non attiva in ArcLab</em> (commessa non obsoleta in
            Marea senza commessa attiva in ArcLab); <em>insediamento diverso</em>; <em>controllo non riconoscibile</em> (la
            descrizione della commessa in Marea non inizia con l'ID del controllo); <em>parametri diversi</em> (parametri della
            commessa in Marea diversi da quelli del controllo in ArcLab, confrontati per nome: possibili falsi allarmi se i nomi sono
            scritti in modo molto diverso). Solo clienti attivi in ArcLab e con codice contabilità; a parte il caso <em>cliente attivo nel
            portale ma non in ArcLab</em>: clienti non obsoleti nel portale che in ArcLab non sono attivi, non hanno il codice
            contabilità, non esistono o non sono collegati (da far disattivare nel portale), con quante righe di listino e commesse
            hanno ancora e l'ultimo accesso al portale. Sola lettura su entrambi i database.</p>
        <div class="griglia-filtri">
            <label>Caso
                <select id="w-caso">
                    <option value="">tutti</option>
                    <option>Descrizione diversa</option>
                    <option>Commessa mancante in Marea</option>
                    <option>Non attiva in ArcLab</option>
                    <option>Insediamento diverso</option>
                    <option>Controllo non riconoscibile</option>
                    <option>Parametri diversi</option>
                    <option>Cliente attivo nel portale ma non in ArcLab</option>
                </select>
            </label>
            <label>Cliente o controllo<input type="text" id="w-testo" placeholder="filtra…" /></label>
        </div>
        <div class="azioni-filtri" style="margin-top:0.6rem">
            <span id="w-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="w-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="w-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:30rem;margin-top:0.6rem">
            <table class="tabella" id="w-tab">
                <thead><tr>
                    <th>Caso</th><th>Cliente</th><th>Insediamento</th><th>Controllo</th><th>Commessa ArcLab</th><th>Commessa Marea</th><th>Dettaglio</th>
                    <th>Commessa ArcLab: data / ultimo rinnovo</th><th>Ultimo campione</th><th>Ultima modifica listino Marea</th>
                </tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

<!-- 12. Commesse attive senza numero di contratto (28/10/2026) -->
<section class="riquadro">
    <details>
        <summary style="cursor:pointer;font-weight:600">12 · Commesse attive senza numero di contratto</summary>
        <p class="sottotesto">Commesse di laboratorio attive (senza data di scadenza) di clienti attivi con codice contabilità, che in ArcLab
            <strong>non hanno il numero di contratto</strong> (commessa.NContratto vuoto). Senza contratto la commessa non arriva nel
            portale: vanno sistemate in ArcLab. «Ultimo campione» = data di ricevimento dell'ultimo lotto sulla commessa, per partire
            da quelle in uso.</p>
        <div class="griglia-filtri">
            <label>Uso
                <select id="y-uso">
                    <option value="">tutte</option>
                    <option value="1">con campioni nell'ultimo anno</option>
                    <option value="3">con campioni negli ultimi 3 anni</option>
                    <option value="mai">mai usate</option>
                </select>
            </label>
            <label>Cliente o controllo<input type="text" id="y-testo" placeholder="filtra…" /></label>
        </div>
        <div class="azioni-filtri" style="margin-top:0.6rem">
            <span id="y-info" class="sottotesto" style="flex:1"></span>
            <button type="button" class="pulsante pulsante-tenue" id="y-esporta">Esporta Excel</button>
            <button type="button" class="pulsante" id="y-cerca">Cerca</button>
        </div>
        <div class="tabella-scorrevole" style="max-height:30rem;margin-top:0.6rem">
            <table class="tabella" id="y-tab">
                <thead><tr>
                    <th>Commessa</th><th>Cliente</th><th>Insediamento</th><th>Controllo</th><th>Descrizione incarico</th>
                    <th class="numerico">Prezzo</th><th>Data commessa</th><th>Ultimo campione</th><th class="numerico">Lotti</th>
                </tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </details>
</section>

