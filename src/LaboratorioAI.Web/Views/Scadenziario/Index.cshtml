@inject LaboratorioAI.Core.Servizi.IContestoUtente Utente
@{
    ViewData["Titolo"] = "Scadenziario tarature";
    var puoGestire = Utente.HaPermesso(LaboratorioAI.Core.Costanti.Permessi.ScadenziarioGestione);
}

<div class="barra-strumenti">
    <div>
        <h1>Scadenziario tarature</h1>
        <p class="sottotitolo">Strumenti interni in scadenza da ArcLab (raggruppati per tipo), archivio dei termometri clienti e generazione delle etichette.</p>
    </div>
</div>

<!-- ══ Interni (ArcLab) ══ -->
<section class="riquadro">
    <div class="barra-risultati"><h2>Interni (ArcLab)</h2><span id="conteggio-interni" class="sottotesto"></span></div>
    <div class="azioni-filtri">
        <label>Preavviso (giorni)<input type="number" id="giorni" value="30" min="0" style="width:6rem" /></label>
        <button type="button" class="pulsante" id="btn-interni">Aggiorna</button>
        <div style="flex:1"></div>
    </div>
    <div id="gruppi-interni"></div>
</section>

<!-- ══ Esterni (clienti) ══ -->
<section class="riquadro">
    <div class="barra-risultati"><h2>Esterni (clienti)</h2><span id="conteggio-esterni" class="sottotesto"></span></div>
    @* 03/11/2026: filtri per cliente, riferimento, stato e preavviso; nascoste le scadute da oltre 12 mesi *@
    <div class="griglia-filtri">
        <label>Cliente<input type="search" id="filtro-cliente" placeholder="parte del nome" /></label>
        <label>Riferimento<select id="filtro-rif"><option value="">tutti</option></select></label>
        <label>Stato
            <select id="filtro-stato">
                <option value="inuso" selected>in uso</option>
                <option value="rinnovata">rinnovate</option>
                <option value="dismessa">dismesse</option>
                <option value="">tutte</option>
            </select>
        </label>
        <label>Tipo<select id="filtro-tipo"><option value="">tutti</option><option value="0">non indicato</option><option value="1">a sonda</option><option value="2">a gabbia</option><option value="3">pirometro</option><option value="4">datalogger</option><option value="5">altro</option></select></label>
        <label>Servizio<select id="filtro-servizio"><option value="">tutti</option><option value="1">solo taratura</option><option value="2">fornitura + taratura</option></select></label>
        <label>Preavviso (giorni)<input type="number" id="filtro-preavviso" min="0" placeholder="vuoto = tutte" style="width:7rem" /></label>
        <label class="casella"><input type="checkbox" id="filtro-vecchie" /> mostra anche scadute da oltre 12 mesi</label>
        <label class="casella"><input type="checkbox" id="filtro-fatturare" /> solo da fatturare</label>
    </div>
    @if (puoGestire)
    {
        <div class="azioni-filtri">
            <input type="file" id="file-import" accept=".xls,.xlsx" />
            <button type="button" class="pulsante pulsante-tenue" id="btn-importa">Importa storico da Excel</button>
            <button type="button" class="pulsante pulsante-tenue" id="btn-svuota-importati">Svuota archivio importato</button>
            <div style="flex:1"></div>
            <button type="button" class="pulsante pulsante-tenue" id="btn-nuovo-esterno">Nuovo termometro</button>
        </div>
    }
    <div class="tabella-scorrevole" style="max-height:26rem">
        <table class="tabella" id="tabella-esterni">
            <thead><tr>
                <th class="numerico">N° Rapporto</th><th>Tipo</th><th>Tipologia</th><th>Servizio</th><th>Taratura</th><th>Scadenza</th><th>Cliente</th><th>Rif.</th><th>Stato</th><th>Consegna</th><th>Fatt.</th><th></th>
            </tr></thead>
            <tbody></tbody>
        </table>
    </div>
</section>

@if (puoGestire)
{
    <section class="riquadro nascosto" id="pannello-esterno">
        <div class="barra-risultati"><h2 id="esterno-titolo">Nuovo termometro esterno</h2></div>
        <input type="hidden" id="e-id" />
        <div class="griglia-filtri">
            <label>N° Rapporto<input type="number" id="e-numero" /></label>
            <label>Tipo<select id="e-tipo"><option value="0">—</option><option value="1">a sonda</option><option value="2">a gabbia</option><option value="3">pirometro</option><option value="4">datalogger</option><option value="5">altro</option></select></label>
            <label>Servizio<select id="e-servizio"><option value="1">solo taratura</option><option value="2">termometro nuovo fornito da noi + taratura</option></select></label>
            <label>Tipologia / descrizione<input type="text" id="e-tipologia" /></label>
            <label>Data taratura<input type="date" id="e-taratura" /></label>
            <label>Data scadenza<input type="date" id="e-scadenza" /></label>
            <label>Cliente<input type="text" id="e-cliente" list="lista-clienti" placeholder="scegli da ArcLab o digita" /><datalist id="lista-clienti"></datalist></label>
            <label>Riferimento<input type="text" id="e-rif" /></label>
            <label>Data consegna<input type="date" id="e-consegna" /></label>
            <label>Operatore consegna<input type="text" id="e-operatore" /></label>
            <label>Rif. fattura<input type="text" id="e-fattura" /></label>
            <label>Note<input type="text" id="e-note" /></label>
            <label class="casella"><input type="checkbox" id="e-fatturare" /> fatturato</label>
            <label class="casella"><input type="checkbox" id="e-escludi-scadenze" /> dismessa (non valutare nelle scadenze)</label>
        </div>
        <div id="pannello-rinnovo-esterno" class="riquadro-tenue nascosto" style="margin-top:0.6rem"></div>
        <div class="azioni-filtri">
            <div style="flex:1"></div>
            <button type="button" class="pulsante pulsante-tenue" id="btn-esterno-annulla">Annulla</button>
            <button type="button" class="pulsante" id="btn-esterno-salva">Salva</button>
        </div>
    </section>
}

@section Script {
    <script type="module" src="~/js/moduli/scadenziario.js" asp-append-version="true"></script>
}
