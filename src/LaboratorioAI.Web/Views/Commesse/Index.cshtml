@{
    ViewData["Titolo"] = "Commesse";
}

<div class="barra-strumenti">
    <div>
        <h1>Commesse</h1>
        <p class="sottotitolo">
            Commesse in vigore per tipologia, cliente e insediamento.
        </p>
    </div>
</div>

<section class="riquadro">
    <div class="griglia-filtri">
        <label>Tipo commessa
            <select id="f-tipo"></select>
        </label>
        <label>Cliente
            <select id="f-cliente"><option value="">Tutti</option></select>
        </label>
        <label>Insediamento
            <select id="f-insediamento"><option value="">Tutti</option></select>
        </label>
        <label>Responsabile<input type="text" id="f-responsabile" /></label>

        <label id="cella-controllo">Controllo
            <select id="f-controllo"><option value="">Tutti</option></select>
        </label>
        <label>Descrizione incarico<input type="text" id="f-descrizione" /></label>
        <label>N° contratto<input type="text" id="f-contratto" /></label>

        <label id="cella-concluse" class="nascosto">Mostra
            <select id="f-concluse">
                <option value="false">Solo attive</option>
                <option value="true">Tutte</option>
            </select>
        </label>
    </div>

    <div class="azioni-filtri">
        <button class="pulsante pulsante-tenue" id="btn-azzera">Azzera</button>
        <button class="pulsante" id="btn-cerca">Cerca</button>
    </div>
</section>

<section class="riquadro nascosto" id="pannello-risultati">
    <div class="barra-risultati"><span id="conteggio"></span></div>
    <div class="tabella-scorrevole">
        <table class="tabella" id="tabella-commesse">
            <thead></thead><tbody></tbody>
        </table>
    </div>
</section>

<section class="riquadro nascosto" id="pannello-esploso">
    <div class="barra-risultati">
        <h2 id="titolo-esploso"></h2>
        <button class="chiudi" id="chiudi-esploso">&times;</button>
    </div>
    <div class="tabella-scorrevole">
        <table class="tabella" id="tabella-esploso">
            <thead></thead><tbody></tbody>
        </table>
    </div>
</section>

@section Script {
    <script type="module" src="~/js/moduli/commesse.js" asp-append-version="true"></script>
}
