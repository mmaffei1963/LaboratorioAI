<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════
  Laboratorio AI — configurazione IIS

  Hosting in-process: l'applicazione gira dentro il processo di IIS.
  Nessun processo esterno, nessuna porta interna, nessun modulo
  aggiuntivo oltre ad ASP.NET Core Hosting Bundle.

  I valori sensibili (TenantId, ClientId, credenziali SQL) NON vanno
  scritti qui: si impostano in appsettings.Production.json protetto
  da ACL, oppure come variabili d'ambiente di sistema.

  Questo file è nel progetto apposta: il publish lo usa come base e
  vi inietta processPath/arguments; così le personalizzazioni qui
  sotto (limiti upload, header di sicurezza, ambiente) sono sempre
  presenti nell'output e il web.config è sovrascrivibile a ogni deploy.
  ═══════════════════════════════════════════════════════════════════
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\LaboratorioAI.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\log\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
