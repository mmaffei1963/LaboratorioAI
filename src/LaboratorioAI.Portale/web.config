<?xml version="1.0" encoding="utf-8"?>
<!--
  Portale Clienti — configurazione IIS, hosting in-process.

  La credenziale dell'accesso operatore va impostata come variabile
  d'ambiente di sistema sul server, non in questo file: il web.config
  finisce nei backup e nel repository.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\LaboratorioAI.Portale.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\log\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="10485760" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
          <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        </customHeaders>
      </httpProtocol>

      <httpErrors existingResponse="PassThrough" />

    </system.webServer>
  </location>
</configuration>
