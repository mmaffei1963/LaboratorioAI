{
  "ConnectionStrings": {
    "LaboratorioAI": "Server=192.168.23.1;Database=LaboratorioAI;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;",
    "ArcLab": "Server=192.168.23.1;Database=LabAnalisiDati;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;"
  },

  "Portale": {
    "_commento": "CredenzialeOperatore NON va scritta qui. Impostarla come variabile d'ambiente Portale__CredenzialeOperatore. Se assente, l'accesso operatore resta disabilitato.",
    "CodiceOperatore": "MAREA",
    "DurataSessioneOre": 8,
    "FinestraTentativiMinuti": 15,
    "TentativiMassimiPerCodice": 8,
    "TentativiMassimiPerIndirizzo": 25,
    "GiorniConservazioneSessioni": 30
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "log/portale-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
