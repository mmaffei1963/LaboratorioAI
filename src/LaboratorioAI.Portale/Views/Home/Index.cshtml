@{
    Layout = "_Layout";
}

<!-- ═══════════ ACCESSO ═══════════ -->
<div id="schermata-accesso" class="schermata-accesso">
    <form class="riquadro-accesso" id="modulo-accesso" autocomplete="on">
        <div class="marchio-accesso">
            <span class="marchio-sigla">M·A</span>
            <div>
                <div class="marchio-nome">MARE.A srl</div>
                <div class="marchio-sotto">Area Clienti</div>
            </div>
        </div>

        <div class="campo">
            <label for="codice">Codice cliente</label>
            <input type="text" id="codice" name="username" autocomplete="username"
                   inputmode="text" required />
        </div>

        <div class="campo">
            <label for="credenziale">Password <span class="nota-campo">(la partita IVA, se non l'hai cambiata)</span></label>
            <input type="password" id="credenziale" name="password"
                   autocomplete="current-password" required />
        </div>

        <label class="ricorda">
            <input type="checkbox" id="ricorda" /> Ricorda il codice cliente
        </label>

        <button type="submit" class="pulsante-accesso" id="btn-entra">Accedi</button>

        <p class="errore-accesso nascosto" id="errore-accesso"></p>

        <!-- 17/11/2026: recupero della password con codice via email -->
        <button type="button" class="link-accesso" id="btn-dimenticata">Password dimenticata?</button>

        <!-- 19/11/2026: accesso del personale MARE.A con Microsoft 365 -->
        <div class="accesso-personale">
            <a class="pulsante-365" href="/operatore/accedi">Accesso personale MARE.A (Microsoft 365)</a>
        </div>

        <p class="nota-accesso">
            MARE.A srl — Via E. Toti, 2 — 47841 Cattolica (RN)
        </p>
    </form>
</div>

<!-- ═══════════ VERIFICA DEL BROWSER NUOVO (18/11/2026) ═══════════ -->
<dialog id="dlg-verifica" class="finestra">
    <h2>Verifica dell'accesso</h2>
    <p id="ver-avviso"></p>
    <div class="campo"><label for="ver-codice">Codice ricevuto per email</label><input type="text" id="ver-codice" inputmode="numeric" autocomplete="one-time-code" maxlength="10" /></div>
    <label class="ricorda"><input type="checkbox" id="ver-ricorda" checked /> Ricorda questo browser per 180 giorni (non spuntare su un computer condiviso)</label>
    <div class="azioni-finestra">
        <button type="button" class="pulsante-tenue" data-chiudi>Annulla</button>
        <button type="button" class="pulsante" id="btn-ver-conferma">Entra</button>
    </div>
    <p class="messaggio-finestra" id="ver-messaggio"></p>
</dialog>

<!-- ═══════════ RECUPERO PASSWORD (17/11/2026) ═══════════ -->
<dialog id="dlg-recupero" class="finestra">
    <h2>Recupero della password</h2>
    <div id="recupero-passo1">
        <p>Indica il codice cliente: invieremo un codice all'indirizzo email del cliente registrato presso MARE.A.</p>
        <div class="campo"><label for="rec-codice">Codice cliente</label><input type="text" id="rec-codice" autocomplete="username" /></div>
        <div class="azioni-finestra">
            <button type="button" class="pulsante-tenue" data-chiudi>Annulla</button>
            <button type="button" class="pulsante" id="btn-rec-invia">Invia il codice</button>
        </div>
    </div>
    <div id="recupero-passo2" class="nascosto">
        <p id="rec-avviso"></p>
        <div class="campo"><label for="rec-token">Codice ricevuto per email</label><input type="text" id="rec-token" inputmode="numeric" autocomplete="one-time-code" maxlength="10" /></div>
        <div class="campo"><label for="rec-nuova">Password nuova (almeno 8 caratteri)</label><input type="password" id="rec-nuova" autocomplete="new-password" /></div>
        <div class="campo"><label for="rec-ripetuta">Ripeti la password nuova</label><input type="password" id="rec-ripetuta" autocomplete="new-password" /></div>
        <div class="azioni-finestra">
            <button type="button" class="pulsante-tenue" data-chiudi>Annulla</button>
            <button type="button" class="pulsante" id="btn-rec-conferma">Imposta la password</button>
        </div>
    </div>
    <p class="messaggio-finestra" id="rec-messaggio"></p>
</dialog>

<!-- ═══════════ APPLICAZIONE ═══════════ -->
<div id="applicazione" class="nascosto">

    <header class="intestazione">
        <div class="marchio">
            <span class="marchio-sigla">M·A</span>
            <div class="marchio-testo">
                <strong>MARE.A srl</strong>
                <small>Area Clienti</small>
            </div>
        </div>
        <div class="intestazione-utente">
            <span id="nome-cliente"></span>
            <button class="pulsante-esci nascosto" id="btn-password" title="Puoi scegliere una password personale al posto della partita IVA">Password</button>
            <button class="pulsante-esci" id="btn-esci">Esci</button>
        </div>
    </header>

    <main>
        <div id="barra-operatore" class="barra-operatore nascosto">
            <label>Accesso operatore — cliente da visualizzare
                <select id="scelta-cliente"><option value="">Tutti i clienti</option></select>
            </label>
            <!-- 17/11/2026: credenziali del cliente scelto, con ripristino della partita IVA -->
            <span id="stato-password" class="stato-password nascosto"></span>
            <button type="button" class="pulsante-tenue nascosto" id="btn-ripristina">Ripristina credenziali originali</button>
        </div>

        <!-- 17/11/2026: schede Campioni / Offerte -->
        <nav class="schede" id="schede">
            <button type="button" class="scheda attiva" data-scheda="sezione-campioni">Campioni</button>
            <button type="button" class="scheda" data-scheda="sezione-offerte">Offerte</button>
            <button type="button" class="scheda" data-scheda="sezione-ordini">Ordini di accettazione</button>
            <button type="button" class="scheda" data-scheda="sezione-documenti">Documenti</button>
        </nav>

        <div id="sezione-campioni">
        <div class="sintesi" id="sintesi">
            <div class="sintesi-voce">
                <span class="sintesi-etichetta">Campioni</span>
                <strong id="s-totale">—</strong>
            </div>
            <div class="sintesi-voce verde">
                <span class="sintesi-etichetta">Certificati</span>
                <strong id="s-certificati">—</strong>
            </div>
            <div class="sintesi-voce arancio">
                <span class="sintesi-etichetta">In corso</span>
                <strong id="s-corso">—</strong>
            </div>
        </div>

        <section class="riquadro">
            <div class="griglia-filtri">
                <label>Ricezione da<input type="date" id="f-da" /></label>
                <label>Ricezione a<input type="date" id="f-a" /></label>
                <label>Struttura
                    <select id="f-insediamento"><option value="">Tutte</option></select>
                </label>
                <label>Matrice
                    <select id="f-matrice"><option value="">Tutte</option></select>
                </label>
                <label>Tipo di controllo
                    <select id="f-controllo"><option value="">Tutti</option></select>
                </label>
                <label>Stato
                    <select id="f-stato">
                        <option value="">Tutti</option>
                        <option value="InCorso">In corso</option>
                        <option value="Certificato">Certificato</option>
                        <option value="SpeditoOriginale">Spedito in originale</option>
                    </select>
                </label>
                <label>Luogo di prelievo<input type="text" id="f-luogo" /></label>
                <label>Punto di prelievo<input type="text" id="f-punto" /></label>
                <label>Verbale<input type="text" id="f-verbale" /></label>
                <label>Ricerca libera<input type="text" id="f-testo" /></label>
            </div>

            <div class="azioni-filtri">
                <button class="pulsante-tenue" id="btn-azzera">Azzera</button>
                <button class="pulsante-tenue" id="btn-esporta">Esporta Excel</button>
                <button class="pulsante" id="btn-cerca">Cerca</button>
            </div>
        </section>

        <section class="riquadro" id="pannello-risultati">
            <div class="barra-risultati">
                <span id="conteggio">Imposta i filtri e avvia la ricerca.</span>
                <span class="avviso nascosto" id="avviso-troncato">
                    Sono mostrati i primi risultati: affina i filtri per un elenco completo.
                </span>
            </div>

            <div class="tabella-scorrevole">
                <table class="tabella" id="tabella-campioni">
                    <thead>
                        <tr>
                            <th>Stato</th><th>N° campione</th><th>Ricezione</th><th>Prelievo</th>
                            <th>Struttura</th><th>Denominazione</th><th>Matrice</th>
                            <th>Controllo</th><th>Luogo</th><th>Punto</th><th>Verbale</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

        <!-- Dettaglio prove: riservato all'accesso operatore -->
        <section class="riquadro nascosto" id="pannello-prove">
            <div class="barra-risultati">
                <h2 id="titolo-prove"></h2>
                <button class="chiudi" id="chiudi-prove">&times;</button>
            </div>

            <div class="avvertenza">
                <strong>Dati gestionali non validati.</strong>
                I valori riportati sono estratti dal sistema informatico del laboratorio
                prima dell'emissione del rapporto di prova. L'unico documento con valore
                legale e tecnico è il <strong>Rapporto di Prova firmato da MARE.A srl</strong>.
                Non utilizzare questi dati per scopi regolatori, legali o di conformità.
            </div>

            <div class="tabella-scorrevole">
                <table class="tabella" id="tabella-prove">
                    <thead>
                        <tr>
                            <th>Parametro</th><th>Valore</th><th>U.M.</th>
                            <th>Riferimento</th><th>Metodo</th><th>Esito</th><th>Eseguito da</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
        </div>

        <!-- 18/11/2026: Ordini di accettazione dei lotti ricevuti -->
        <div id="sezione-ordini" class="nascosto">
            <section class="riquadro">
                <div class="griglia-filtri">
                    <label>Ricevuti dal<input type="date" id="o-dal" /></label>
                    <label>al<input type="date" id="o-al" /></label>
                    <label>Insediamento<select id="o-insediamento"><option value="">Tutti</option></select></label>
                    <label>N° lotto<input type="text" id="o-lotto" placeholder="es. 10831" /></label>
                </div>
                <div class="azioni-filtri"><button class="pulsante" id="btn-ordini-cerca">Cerca</button></div>
            </section>
            <section class="riquadro">
                <div class="barra-risultati"><span id="ordini-stato">Scegli il periodo e premi Cerca.</span></div>
                <div class="tabella-scorrevole">
                    <table class="tabella" id="tabella-ordini">
                        <thead><tr><th>N° lotto</th><th>Ricevuto il</th><th>Insediamento</th><th>Campioni</th><th>Ordine</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
                <p class="piccolo-nota">L'Ordine di accettazione riporta i campioni ricevuti, le analisi richieste e le Condizioni generali di fornitura in vigore alla data di ricezione.</p>
            </section>
        </div>

        <!-- 19/11/2026: Documenti pubblicati (da Palomar / Marea.Entries) -->
        <div id="sezione-documenti" class="nascosto">
            <section class="riquadro">
                <div class="griglia-filtri" id="filtri-documenti">
                    <label>Area<select id="d-area"></select></label>
                    <label>Esito<select id="d-esito">
                        <option value="">Tutti</option>
                        <option value="0">Solo conformi</option>
                        <option value="1">Solo non conformi</option>
                    </select></label>
                    <label>Lettura<select id="d-letto">
                        <option value="">Tutti</option>
                        <option value="0">Solo da leggere</option>
                        <option value="1">Solo letti</option>
                    </select></label>
                    <label>Insediamento<select id="d-insediamento"><option value="">Tutti</option></select></label>
                    <label>Tipo di documento<select id="d-tipo"><option value="">Tutti</option></select></label>
                    <label>Caricati dal<input type="date" id="d-dal" /></label>
                    <label>al<input type="date" id="d-al" /></label>
                    <label>Titolo<input type="text" id="d-titolo" /></label>
                    <label>Campione<input type="text" id="d-campione" /></label>
                    <label>Prelievo dal<input type="date" id="d-pdal" /></label>
                    <label>al<input type="date" id="d-pal" /></label>
                    <label>N° verbale<input type="text" id="d-verbale" /></label>
                    <label>Luogo di prelievo<input type="text" id="d-luogo" /></label>
                    <label>Punto di prelievo<input type="text" id="d-punto" /></label>
                    <label>Scadenza dal<input type="date" id="d-sdal" /></label>
                    <label>al<input type="date" id="d-sal" /></label>
                    <label>Etichette<input type="text" id="d-tag" placeholder="es. TAMPONI" /></label>
                </div>
                <div class="azioni-filtri"><button class="pulsante-tenue" id="btn-doc-azzera">Azzera filtri</button></div>
            </section>
            <section class="riquadro">
                <div class="barra-risultati"><span id="documenti-stato">Caricamento dei documenti…</span></div>
                <div class="tabella-scorrevole">
                    <table class="tabella tabella-documenti" id="tabella-documenti">
                        <thead><tr>
                            <th></th><th>Insediamento</th><th>Caricato il</th><th>Tipo</th><th>Titolo</th><th>Campione</th>
                            <th>Prelievo</th><th>Verbale</th><th>Luogo di prelievo</th><th>Punto di prelievo</th><th>Scadenza</th>
                        </tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
                <p class="piccolo-nota">In grassetto i documenti non ancora scaricati. I certificati pubblicati sono firmati digitalmente.</p>
            </section>
        </div>

        <!-- 17/11/2026: Offerte — offerta di laboratorio dalle commesse attive -->
        <div id="sezione-offerte" class="nascosto">
            <section class="riquadro">
                <div class="barra-risultati">
                    <span id="offerta-stato">Caricamento dell'offerta…</span>
                    <button class="pulsante" id="btn-offerta-pdf" disabled>Scarica PDF</button>
                </div>
                <div id="offerta-contenuto" class="offerta"></div>
            </section>
        </div>
    </main>

    <!-- 17/11/2026: cambio password del cliente -->
    <dialog id="dlg-password" class="finestra">
        <h2>Password personale</h2>
        <p>Se vuoi, puoi scegliere una password personale al posto della partita IVA. Da quel momento per entrare vale solo la
            password nuova; se la dimentichi puoi recuperarla dalla pagina di accesso con un codice inviato per email.</p>
        <div class="campo"><label for="pw-attuale">Password attuale (la partita IVA, se non l'hai mai cambiata)</label><input type="password" id="pw-attuale" autocomplete="current-password" /></div>
        <div class="campo"><label for="pw-nuova">Password nuova (almeno 8 caratteri)</label><input type="password" id="pw-nuova" autocomplete="new-password" /></div>
        <div class="campo"><label for="pw-ripetuta">Ripeti la password nuova</label><input type="password" id="pw-ripetuta" autocomplete="new-password" /></div>
        <div class="azioni-finestra">
            <button type="button" class="pulsante-tenue" data-chiudi>Chiudi</button>
            <button type="button" class="pulsante" id="btn-pw-salva">Cambia password</button>
        </div>
        <p class="messaggio-finestra" id="pw-messaggio"></p>
    </dialog>

    <footer class="pie">
        MARE.A srl — Via E. Toti, 2 — 47841 Cattolica (RN) — Tel. 0541 830442
    </footer>
</div>
